<script>
  import { svrTransition } from './svr-transition';
  import { PSEUDONYM } from './manifest';

  type Comment = { date: string; author?: string; message: string; html?: string; pending?: boolean };
  type Entry = {
    id: string; name: string; page: string; message: string; status: string; createdAt: string;
    /** The goal of the request in a few words, written by the AI triage (optional). */
    title?: string;
    /** 'site': the change concerns every page; 'page' (or missing on older entries): only `page`. */
    scope?: 'page' | 'site';
    images: { name: string; url: string }[];
    comments?: Comment[];
    /** How the AI developer read the feedback (English), and the commit that addressed it. */
    interpretation?: { text: string; by?: string; date?: string; commit?: string };
    /** Interpretations proposed by the feedback-triage skill; the tester picks one. */
    proposals?: {
      by?: string; date?: string; recommended?: string; chosen?: string; chosenAt?: string;
      options: { key: string; title: string; interpretation: string; implementation?: string; effort?: string; vision?: string }[];
    };
    metadata?: {
      viewport?: { width: number; height: number };
      embeds?: { kind: 'youtube' | 'map' | 'iframe'; url: string; title?: string }[];
      screenshotFailed?: boolean;
    };
  };
  type Filter = 'new' | 'in_progress' | 'done';
  type View = 'feedback' | 'changelog' | 'notes';

  const API = '/__feedback/api/entries';
  // Feedback is anonymous (PSEUDONYM); older entries may still carry a name, never shown.
  const STATUS_KEY: Record<string, Filter> = { New: 'new', 'In progress': 'in_progress', Done: 'done' };
  const FILTER_STATUS: Record<Filter, string> = { new: 'New', in_progress: 'In progress', done: 'Done' };
  // Old links (#new, #in-progress, …) still open the Feedback tab with that filter.
  const LEGACY_HASH: Record<string, Filter> = { '#new': 'new', '#in-progress': 'in_progress', '#done': 'done', '#all': 'new' };
  const EMBED_LABELS: Record<string, string> = { youtube: '▶ YouTube video', map: 'Map', iframe: 'Embed' };
  const FILTER_KEY = 'feedback-status-filter';
  const ICON = {
    check: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>',
