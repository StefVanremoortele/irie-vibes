---
import { execFileSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';
import { MANIFEST_TEXT, MANIFEST_TITLE } from './manifest';

// When the website (code, not content) last changed: the date of the latest
// commit that touches anything outside the CMS-owned paths, so content edits
// and media uploads from the Sveltia admin (also commits on main) don't count.
// Falls back to the build time outside a git checkout.
const CMS_PATHS = [':(exclude)content', ':(exclude)public/assets'];
let lastUpdated = new Date().toISOString();
try {
  lastUpdated = execFileSync('git', ['log', '-1', '--format=%cI', '--', '.', ...CMS_PATHS], { encoding: 'utf8' }).trim() || lastUpdated;
} catch {
  // Not a git checkout: keep the build time.
}
---

<!--
  Testing page (/feedback): a dialog over the real homepage (shown inert behind
  a dark scrim). The dialog is a tester tool with its own design tokens (Pane,
  scoped to .fbx) and deliberately does NOT follow the festival design system;
  see README "Feedback tool". Tabs: Feedback (inbox split: list + detail),
  Changelog (timeline) and Developer notes.
-->
<Base title="Testing" description="Website feedback, changelog and developer notes for testers" noIndex>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="inbox-behind" inert aria-hidden="true"><HomeContent /></div>

  <div class="fbx">
    <div class="fbx-scrim" data-close aria-hidden="true"></div>
    <section class="fbx-panel" role="dialog" aria-modal="true" aria-labelledby="fbx-title">
      <h1 id="fbx-title" class="fbx-sr">Testing</h1>
      <header class="fbx-head">
        <nav class="fbx-tabs" aria-label="Sections">
          <a class="fbx-tab" href="#feedback" data-view="feedback">Feedback <span class="fbx-count fbx-count--accent" data-count="New"></span></a>
          <a class="fbx-tab" href="#changelog" data-view="changelog">Changelog</a>
          <a class="fbx-tab" href="#notes" data-view="notes">Developer notes <span class="fbx-count" data-count="Notes"></span></a>
        </nav>
        <div class="fbx-head__end">
          <span class="fbx-updated"><span class="fbx-dot" aria-hidden="true"></span><span>Site updated <time id="last-updated" datetime={lastUpdated}>{new Date(lastUpdated).toUTCString()}</time></span></span>
          <button type="button" class="fbx-key" data-close title="Close (Esc)" aria-label="Close">Esc</button>
        </div>
      </header>

      <!-- Feedback: inbox split -->
      <div id="feedback-view" class="fbx-view fbx-split">
        <aside class="fbx-list" aria-label="Feedback list">
          <div class="fbx-chips" role="group" aria-label="Filter by status">
            <button type="button" class="fbx-chip" data-filter="new">New <span data-count="New"></span></button>
            <button type="button" class="fbx-chip" data-filter="in_progress">In progress <span data-count="In progress"></span></button>
            <button type="button" class="fbx-chip" data-filter="done">Done <span data-count="Done"></span></button>
            <button type="button" class="fbx-chip" data-filter="all">All <span data-count="All"></span></button>
          </div>
          <div id="entries" class="fbx-rows" aria-live="polite"><p class="fbx-empty">Loading feedback…</p></div>
          <button type="button" class="fbx-addnote" data-add-note>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
            Add a note without a screenshot
          </button>
        </aside>

        <div class="fbx-detail">
          <div id="detail" class="fbx-detail__item">
            <header class="fbx-detail__head" id="detail-head"></header>
            <div class="fbx-detail__body" id="detail-body"><p class="fbx-empty">Select feedback on the left.</p></div>
            <form class="fbx-composer" id="composer" hidden>
              <textarea name="message" rows="1" maxlength="5000" required placeholder="Reply to the developer…" aria-label="Reply"></textarea>
              <button type="submit" class="fbx-btn fbx-btn--dark">Send</button>
              <p class="fbx-composer__status" role="status"></p>
            </form>
          </div>

          <!-- Add a note without a screenshot -->
          <div id="note-pane" class="fbx-detail__item" hidden>
            <header class="fbx-detail__head">
              <button type="button" class="fbx-back" data-back aria-label="Back to the list"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></button>
              <h2 class="fbx-detail__title">Add a note without a screenshot</h2>
            </header>
            <form id="feedback-form" class="fbx-detail__body fbx-noteform">
              <label class="fbx-field">Comment<textarea name="message" required maxlength="10000" rows="4" placeholder="Describe what you noticed…"></textarea></label>
              <label class="fbx-field">Page <span>(optional)</span><input name="page" maxlength="500" placeholder="/tickets" /></label>
              <div class="fbx-dropzone" id="dropzone" tabindex="0" role="button" aria-label="Add images">
                Drop or paste images here, or <button type="button" id="pick-images">choose files</button>
                <input id="image-input" type="file" accept="image/*" multiple hidden />
              </div>
              <div class="fbx-previews" id="previews"></div>
              <div class="fbx-noteform__actions"><button class="fbx-btn fbx-btn--primary" type="submit">Add note</button><p id="form-status" role="status"></p></div>
            </form>
          </div>
        </div>
      </div>

      <!-- Changelog: timeline -->
      <div id="changelog-view" class="fbx-view fbx-scroll" hidden>
        <div id="changelog-body" class="fbx-timeline" aria-live="polite"><p class="fbx-empty">Loading changelog…</p></div>
      </div>

      <!-- Developer notes: same timeline -->
      <div id="notes-view" class="fbx-view fbx-scroll" hidden>
        <div id="notes-list" class="fbx-timeline" aria-live="polite"><p class="fbx-empty">Loading notes…</p></div>
      </div>
    </section>
    <div id="jah-manifest" class="fbx-manifest" role="tooltip" hidden><strong>{MANIFEST_TITLE}</strong><p>{MANIFEST_TEXT}</p></div>
  </div>

  <dialog id="lightbox" class="fbx fbx-lightbox"><form method="dialog"><button aria-label="Close">×</button></form><img alt="" /></dialog>
</Base>

<style is:global>
  /* ---- Tokens (Pane design system), scoped to the dialog ------------------ */
  .fbx {
    --ink-900: #1a1b26; --ink-700: #2e2f3e; --ink-500: #5b5c6e; --ink-400: #8b8c9e; --ink-300: #b8b9c8; --ink-200: #d8d9e3;
    --divider: rgba(26, 27, 38, 0.10);
    --accent-500: #7c5cff; --accent-600: #6b49f0; --accent-400: #9d82ff; --accent-100: #ece6ff; --accent-tint: rgba(124, 92, 255, 0.12);
    --success-500: #10b981; --success-100: #d1fae5; --success-700: #047857;
    --warn-500: #f59e0b; --warn-100: #fef3c7; --warn-700: #92600a;
    --info-500: #3b82f6; --info-100: #dbeafe;
    --danger-500: #ef4444; --danger-100: #fee2e2;
    --radius-xs: 6px; --radius-sm: 10px; --radius-md: 14px; --radius-lg: 20px; --radius-pill: 999px;
    --shadow-sm: 0 1px 2px rgba(26, 27, 38, 0.04), 0 2px 8px rgba(26, 27, 38, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    --shadow-xl: 0 8px 16px rgba(26, 27, 38, 0.06), 0 40px 80px rgba(26, 27, 38, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    --shadow-focus: 0 0 0 3px rgba(124, 92, 255, 0.35);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1); --ease-smooth: cubic-bezier(0.32, 0.72, 0, 1);
    --dur-fast: 140ms; --dur-med: 260ms; --dur-slow: 420ms;
    --font-display: 'Fraunces', 'Iowan Old Style', 'Palatino', Georgia, serif;
    --font-body: 'Inter Tight', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    --font-mono: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;
    color: var(--ink-700);
    font: 400 15px/1.5 var(--font-body);
    letter-spacing: normal;
    text-transform: none;
    -webkit-font-smoothing: antialiased;
  }
  .fbx *, .fbx *::before, .fbx *::after { box-sizing: border-box; }
  .fbx :where(button, input, textarea) { font: inherit; color: inherit; }
  .fbx :where(a) { color: var(--accent-600); }
  .fbx svg { flex: none; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .fbx-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .fbx :focus-visible { outline: none; box-shadow: var(--shadow-focus); }

  /* ---- Shell: scrim + panel over the inert homepage ----------------------- */
  html:has(.fbx-panel) { overflow: hidden; }
  .inbox-behind { width: 100%; }
  .fbx-scrim { position: fixed; inset: 0; z-index: 9500; background: rgba(26, 27, 38, 0.6); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: fbx-fade var(--dur-slow) var(--ease-smooth); }
  .fbx-panel { position: fixed; inset: 40px; z-index: 9600; max-width: 1360px; margin: 0 auto; display: grid; grid-template-rows: auto minmax(0, 1fr); overflow: hidden; background: rgba(255, 255, 255, 0.95); border: 1px solid rgba(255, 255, 255, 0.65); border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); animation: fbx-enter var(--dur-slow) var(--ease-smooth); }
  .fbx.is-closing .fbx-panel { animation: fbx-exit var(--dur-med) var(--ease-smooth) forwards; }
  .fbx.is-closing .fbx-scrim { animation: fbx-fade var(--dur-med) var(--ease-smooth) reverse forwards; }
  @keyframes fbx-fade { from { opacity: 0; } }
  @keyframes fbx-enter { from { opacity: 0; transform: translateY(8px); } }
  @keyframes fbx-exit { to { opacity: 0; transform: scale(0.98); } }
  @media (prefers-reduced-motion: reduce) {
    .fbx-panel { animation-name: fbx-fade; }
    .fbx.is-closing .fbx-panel { animation-name: fbx-fade; animation-direction: reverse; }
    .fbx *, .fbx *::before, .fbx *::after { transition-duration: 0s !important; }
  }

  /* Header: tabs left, "site updated" + Esc right */
  .fbx-head { display: flex; align-items: stretch; justify-content: space-between; gap: 16px; min-height: 60px; padding: 0 28px 0 16px; border-bottom: 1px solid var(--divider); }
  .fbx-tabs { display: flex; align-items: stretch; }
  .fbx a.fbx-tab { display: inline-flex; align-items: center; gap: 8px; padding: 0 12px; color: var(--ink-500); font-size: 15px; font-weight: 500; text-decoration: none; transition: color var(--dur-fast); }
  .fbx a.fbx-tab:hover { color: var(--ink-900); }
  .fbx a.fbx-tab.is-active { color: var(--ink-900); font-weight: 600; box-shadow: inset 0 -2px 0 var(--accent-500); }
  .fbx a.fbx-tab:focus-visible { box-shadow: inset 0 0 0 3px rgba(124, 92, 255, 0.35); border-radius: var(--radius-xs); }
  .fbx-count { padding: 1px 7px; border-radius: var(--radius-pill); background: var(--ink-200); color: var(--ink-700); font-size: 12px; font-weight: 600; line-height: 1.4; }
  .fbx-count--accent, .fbx-count.has-unseen { background: var(--accent-500); color: #fff; }
  .fbx-count:empty { display: none; }
  .fbx-head__end { display: flex; align-items: center; gap: 16px; }
  .fbx-updated { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-500); font-size: 13px; white-space: nowrap; }
  .fbx-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success-500); }
  .fbx-key { padding: 3px 6px; border: 0; border-radius: var(--radius-xs); background: rgba(26, 27, 38, 0.05); color: var(--ink-500); font: 500 11px/1.2 var(--font-mono); cursor: pointer; transition: background var(--dur-fast); }
  .fbx-key:hover { background: rgba(26, 27, 38, 0.1); }

  .fbx-view { min-height: 0; }
  .fbx-view[hidden] { display: none; }
  .fbx-scroll { overflow-y: auto; overscroll-behavior: contain; }
  .fbx-empty { margin: 0; padding: 24px; color: var(--ink-400); font-size: 14px; text-align: center; }

  /* ---- Feedback: inbox split ---------------------------------------------- */
  .fbx-split { display: grid; grid-template-columns: 340px minmax(0, 1fr); }
  .fbx-list { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; min-height: 0; background: rgba(26, 27, 38, 0.025); border-right: 1px solid var(--divider); }
  .fbx-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 20px 20px 12px; }
  .fbx-chip { padding: 4px 10px; border: 1px solid var(--divider); border-radius: var(--radius-pill); background: none; color: var(--ink-500); font-size: 12px; font-weight: 500; cursor: pointer; transition: background var(--dur-fast), transform var(--dur-fast) var(--ease-spring); }
  .fbx-chip:hover { background: rgba(26, 27, 38, 0.04); }
  .fbx-chip:active { transform: scale(0.97); }
  .fbx-chip.is-active { border-color: transparent; background: var(--accent-tint); color: var(--accent-600); font-weight: 600; }
  .fbx-chip span:empty { display: none; }
  .fbx-rows { display: grid; align-content: start; gap: 2px; padding: 0 8px 8px; overflow-y: auto; overscroll-behavior: contain; }
  .fbx-row { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; align-items: center; width: 100%; padding: 12px; border: 0; border-radius: var(--radius-sm); background: none; text-align: left; cursor: pointer; transition: background var(--dur-fast), box-shadow var(--dur-fast); }
  .fbx-row:hover { background: rgba(26, 27, 38, 0.04); }
  .fbx-row.is-selected { background: #fff; box-shadow: var(--shadow-sm); }
  .fbx-row.is-selected:focus-visible { box-shadow: var(--shadow-sm), var(--shadow-focus); }
  .fbx-row.is-leaving { animation: fbx-leave var(--dur-med) var(--ease-smooth) forwards; }
  @keyframes fbx-leave { to { opacity: 0; transform: translateX(-12px); } }
  .fbx-row__thumb { width: 56px; height: 42px; overflow: hidden; border-radius: 8px; background: rgba(26, 27, 38, 0.06); }
  .fbx-row__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .fbx-row__text { display: grid; gap: 2px; min-width: 0; }
  .fbx-row__meta { display: flex; align-items: center; gap: 6px; min-width: 0; color: var(--ink-400); font-size: 12px; }
  .fbx-row__path { overflow: hidden; font-family: var(--font-mono); text-overflow: ellipsis; white-space: nowrap; }
  .fbx-row__time { margin-left: auto; white-space: nowrap; }
  .fbx-row__comment { overflow: hidden; color: var(--ink-900); font-size: 14px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
  .fbx-sdot { width: 6px; height: 6px; flex: none; border-radius: 50%; }
  .fbx-sdot--new { background: var(--accent-500); }
  .fbx-sdot--in_progress { background: var(--warn-500); }
  .fbx-sdot--done { background: var(--success-500); }
  .fbx-addnote { display: flex; align-items: center; justify-content: center; gap: 8px; height: 48px; margin: 8px 16px 16px; border: 1px dashed var(--ink-300); border-radius: var(--radius-md); background: none; color: var(--ink-500); font-size: 14px; font-weight: 500; cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast); }
  .fbx-addnote:hover, .fbx-addnote.is-active { background: rgba(26, 27, 38, 0.04); color: var(--ink-900); }

  .fbx-detail { min-height: 0; }
  .fbx-detail__item { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; height: 100%; min-height: 0; }
  .fbx-detail__item[hidden] { display: none; }
  .fbx-detail__head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; min-height: 67px; padding: 16px 24px; border-bottom: 1px solid var(--divider); }
  .fbx-detail__head:empty { display: none; }
  .fbx-detail__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; min-width: 0; color: var(--ink-500); font-size: 13px; }
  .fbx-detail__meta a { font-weight: 500; }
  .fbx-detail__title { margin: 0; color: var(--ink-900); font: 600 15px/1.3 var(--font-body); }
  .fbx-detail__actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .fbx-detail__body { display: grid; align-content: start; gap: 20px; padding: 24px; overflow-y: auto; overscroll-behavior: contain; }
  .fbx-back { display: none; }

  .fbx-pill { padding: 2px 9px; border-radius: var(--radius-pill); font-size: 12px; font-weight: 600; line-height: 1.5; white-space: nowrap; }
  .fbx-pill--new { background: var(--accent-tint); color: var(--accent-600); }
  .fbx-pill--in_progress, .fbx-pill--warn { background: var(--warn-100); color: var(--warn-700); }
  .fbx-pill--done { background: var(--success-100); color: var(--success-700); }
  .fbx-pill--danger { background: var(--danger-100); color: #b91c1c; }

  .fbx-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 34px; padding: 0 14px; border: 1px solid var(--divider); border-radius: var(--radius-sm); background: #fff; color: var(--ink-700); font-size: 13px; font-weight: 500; white-space: nowrap; cursor: pointer; transition: background var(--dur-fast), filter var(--dur-fast), transform var(--dur-fast) var(--ease-spring); }
  .fbx-btn:hover { background: rgba(26, 27, 38, 0.04); }
  .fbx-btn:active { transform: scale(0.97); }
  .fbx-btn:disabled { opacity: 0.55; cursor: progress; }
  .fbx-btn--primary { border-color: transparent; background: var(--accent-500); color: #fff; font-weight: 600; }
  .fbx-btn--primary:hover { background: var(--accent-500); filter: brightness(1.08); }
  .fbx-btn--dark { height: 42px; border-color: transparent; background: var(--ink-900); color: #fff; font-size: 14px; font-weight: 600; }
  .fbx-btn--dark:hover { background: var(--ink-900); filter: brightness(1.25); }
  .fbx-icon-btn { display: inline-grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 0; border-radius: var(--radius-sm); background: none; color: var(--ink-500); cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast), transform var(--dur-fast) var(--ease-spring); }
  .fbx-icon-btn:hover { background: var(--danger-100); color: var(--danger-500); }
  .fbx-icon-btn:active { transform: scale(0.97); }

  .fbx-shot { position: relative; height: 300px; overflow: hidden; border-radius: var(--radius-md); background: rgba(26, 27, 38, 0.06); }
  .fbx-shot__open { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .fbx-shot__open img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .fbx-shot--none { display: grid; place-items: center; height: 120px; color: var(--ink-400); font-size: 13px; }
  .fbx-shot__chips { position: absolute; left: 12px; bottom: 12px; display: flex; flex-wrap: wrap; gap: 6px; pointer-events: none; }
  .fbx-shot__chip { padding: 2px 7px; border-radius: var(--radius-xs); background: rgba(26, 27, 38, 0.6); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: #fff; font: 500 11px/1.5 var(--font-mono); }
  .fbx-shot--none .fbx-shot__chip { background: rgba(26, 27, 38, 0.06); color: var(--ink-500); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .fbx a.fbx-shot__link { position: absolute; right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: var(--radius-xs); background: #fff; color: var(--ink-900); font-size: 12px; font-weight: 600; text-decoration: none; box-shadow: var(--shadow-sm); }
  .fbx-more { display: flex; flex-wrap: wrap; gap: 8px; margin-top: -8px; }
  .fbx-more button { width: 72px; height: 52px; padding: 0; overflow: hidden; border: 1px solid var(--divider); border-radius: 8px; background: none; cursor: zoom-in; }
  .fbx-more img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fbx-comment { margin: 0; color: var(--ink-900); font-size: 20px; line-height: 1.45; text-wrap: pretty; white-space: pre-wrap; overflow-wrap: anywhere; }

  .fbx-scope { display: inline-flex; align-items: center; padding: 1px 8px; border-radius: var(--radius-pill); background: var(--accent-tint); color: var(--accent-600); font-size: 11px; font-weight: 600; white-space: nowrap; }

  /* AI interpretation: how the developer's AI read the comment */
  .fbx-ai { padding: 12px 14px; border-left: 3px solid var(--accent-500); border-radius: 0 12px 12px 0; background: var(--accent-tint); }
  .fbx-ai__label { color: var(--ink-500); font-size: 12px; font-weight: 600; letter-spacing: 0.02em; }
  .fbx-ai__text { margin: 4px 0 0; color: var(--ink-900); font-size: 15px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }

  /* Proposed interpretations: the tester picks the one they meant */
  .fbx-props { display: grid; gap: 10px; }
  .fbx-props__intro { margin: 0; color: var(--ink-500); font-size: 14px; }
  .fbx-props__option { display: grid; gap: 6px; padding: 12px 14px; border: 1px solid var(--divider); border-radius: 12px; background: #fff; transition: border-color var(--dur-fast), box-shadow var(--dur-fast); }
  .fbx-props__option.is-chosen { border-color: var(--accent-500); box-shadow: 0 0 0 3px var(--accent-tint); }
  .fbx-props__head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; color: var(--ink-900); font-size: 15px; }
  .fbx-props__key { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent-100); color: var(--accent-600); font-size: 12px; font-weight: 700; }
  .fbx-props__chip { padding: 1px 8px; border-radius: var(--radius-pill); background: rgba(26, 27, 38, 0.05); color: var(--ink-500); font-size: 11px; font-weight: 600; }
  .fbx-props__chip--rec { background: var(--accent-tint); color: var(--accent-600); }
  .fbx-props__text { margin: 0; color: var(--ink-900); font-size: 15px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
  .fbx-props__how summary { color: var(--ink-500); font-size: 13px; cursor: pointer; }
  .fbx-props__how p { margin: 6px 0 0; color: var(--ink-700); font-size: 13px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
  .fbx-props__action { display: flex; justify-content: flex-end; }
  .fbx-props__chosen { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-600); font-size: 13px; font-weight: 600; }

  /* Thread: developer bubbles left, tester replies right */
  .fbx-thread { display: grid; gap: 10px; }
  .fbx-bubble { justify-self: start; max-width: 70%; padding: 10px 14px; border-radius: 14px 14px 14px 4px; background: var(--accent-100); overflow-wrap: anywhere; }
  .fbx-bubble--tester { justify-self: end; border-radius: 14px 14px 4px 14px; background: rgba(26, 27, 38, 0.05); }
  .fbx-bubble--pending { opacity: 0.6; }
  .fbx-bubble__label { margin-bottom: 2px; color: var(--accent-600); font-size: 12px; font-weight: 600; }
  .fbx-bubble--tester .fbx-bubble__label { color: var(--ink-500); }
  .fbx-bubble__body { color: var(--ink-900); font-size: 15px; line-height: 1.5; }
  .fbx-bubble__body > * { margin: 0 0 6px; }
  .fbx-bubble__body > :last-child { margin-bottom: 0; }
  .fbx-bubble__body img { display: block; max-width: 100%; max-height: 260px; border-radius: 8px; cursor: zoom-in; }
  .fbx-bubble__body code { padding: 1px 5px; border-radius: var(--radius-xs); background: rgba(26, 27, 38, 0.06); font: 13px var(--font-mono); }

  .fbx-composer { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: end; padding: 16px 24px; border-top: 1px solid var(--divider); }
  .fbx-composer[hidden] { display: none; }
  .fbx-composer textarea, .fbx-field input, .fbx-field textarea { width: 100%; padding: 10px 14px; border: 1px solid var(--divider); border-radius: var(--radius-sm); background: #fff; color: var(--ink-900); font-size: 14px; line-height: 1.45; resize: none; transition: box-shadow var(--dur-fast), border-color var(--dur-fast); }
  .fbx-composer textarea { min-height: 42px; max-height: 140px; }
  .fbx-composer textarea::placeholder, .fbx-field ::placeholder { color: var(--ink-400); }
  .fbx-composer textarea:focus, .fbx-field input:focus, .fbx-field textarea:focus { outline: none; border-color: var(--accent-400); box-shadow: var(--shadow-focus); }
  .fbx-composer__status { grid-column: 1 / -1; margin: 0; color: #b91c1c; font-size: 13px; }
  .fbx-composer__status:empty { display: none; }

  /* Add-note form */
  .fbx-noteform { gap: 14px; }
  .fbx-field { display: grid; gap: 6px; color: var(--ink-900); font-size: 14px; font-weight: 600; }
  .fbx-field span { color: var(--ink-400); font-weight: 400; }
  .fbx-field textarea { resize: vertical; }
  .fbx-dropzone { padding: 16px; border: 1px dashed var(--ink-300); border-radius: var(--radius-md); color: var(--ink-500); font-size: 14px; text-align: center; cursor: pointer; transition: background var(--dur-fast); }
  .fbx-dropzone.is-over { border-color: var(--accent-500); background: var(--accent-tint); }
  .fbx-dropzone button { padding: 0; border: 0; background: none; color: var(--accent-600); font-weight: 600; text-decoration: underline; cursor: pointer; }
  .fbx-previews { display: flex; flex-wrap: wrap; gap: 8px; }
  .fbx-previews:empty { display: none; }
  .fbx .preview { position: relative; width: 72px; height: 72px; overflow: hidden; border-radius: var(--radius-sm); }
  .fbx .preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fbx .preview button { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; padding: 0; border: 0; border-radius: 50%; background: rgba(26, 27, 38, 0.7); color: #fff; font-size: 13px; line-height: 1; cursor: pointer; }
  .fbx-noteform__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  #form-status { margin: 0; color: var(--ink-500); font-size: 13px; }

  /* ---- Changelog + developer notes: timeline ------------------------------ */
  .fbx-timeline { padding: 32px 40px 40px; }
  .fbx-entry { display: grid; grid-template-columns: 120px 20px minmax(0, 1fr); gap: 20px; }
  .fbx-entry__date { text-align: right; }
  .fbx-entry__day { display: block; color: var(--ink-900); font: 400 32px/1 var(--font-display); font-variation-settings: 'opsz' 72; letter-spacing: -0.02em; }
  .fbx-entry__month { display: block; margin-top: 6px; color: var(--ink-400); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .fbx-entry__rail { position: relative; display: flex; justify-content: center; }
  .fbx-entry__rail::before { content: ''; position: relative; z-index: 1; width: 12px; height: 12px; margin-top: 8px; border: 2px solid var(--ink-300); border-radius: 50%; background: #fff; }
  .fbx-entry:first-child .fbx-entry__rail::before { border: 0; background: var(--accent-500); box-shadow: 0 0 0 4px var(--accent-tint); }
  .fbx-entry:not(:last-child) .fbx-entry__rail::after { content: ''; position: absolute; top: 24px; bottom: -4px; left: 50%; width: 2px; transform: translateX(-50%); background: var(--ink-200); }
  .fbx-entry__content { display: grid; align-content: start; gap: 10px; min-width: 0; padding-bottom: 32px; }
  .fbx-entry__title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 0; color: var(--ink-900); font: 600 19px/1.3 var(--font-body); letter-spacing: -0.01em; }
  .fbx-entry__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; color: var(--ink-500); font-size: 13px; }
  .fbx-entry__body { max-width: 720px; color: var(--ink-700); font-size: 15px; line-height: 1.65; overflow-wrap: anywhere; }
  .fbx-entry__body > * { margin: 0 0 10px; }
  .fbx-entry__body > :last-child { margin-bottom: 0; }
  .fbx-entry__body--plain { white-space: pre-wrap; }
  .fbx-entry__body h1, .fbx-entry__body h2, .fbx-entry__body h3 { color: var(--ink-900); font: 600 16px/1.4 var(--font-body); }
  .fbx-entry__body ul, .fbx-entry__body ol { padding-left: 1.3em; }
  .fbx-entry__body img { max-width: 100%; border-radius: var(--radius-sm); }
  .fbx-entry__body pre { padding: 10px 12px; overflow-x: auto; border-radius: var(--radius-sm); background: rgba(26, 27, 38, 0.05); }
  .fbx :is(.fbx-entry__body, .fbx-change__text) code { padding: 1px 6px; border-radius: var(--radius-xs); background: rgba(26, 27, 38, 0.06); color: var(--ink-700); font: 13px var(--font-mono); }
  .fbx-entry__body pre code { padding: 0; background: none; }
  .fbx-changes { display: grid; gap: 10px; max-width: 820px; }
  .fbx-change { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .fbx-tag { justify-self: start; padding: 2px 8px; border-radius: var(--radius-pill); background: rgba(26, 27, 38, 0.06); color: var(--ink-500); font-size: 11px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; white-space: nowrap; }
  .fbx-tag--infra { background: var(--info-100); color: var(--info-500); }
  .fbx-tag--new { background: var(--accent-100); color: var(--accent-600); }
  .fbx-tag--fix { background: var(--success-100); color: var(--success-700); }
  .fbx-tag--change { background: var(--warn-100); color: var(--warn-700); }
  .fbx-change__text { color: var(--ink-700); font-size: 15px; line-height: 1.6; overflow-wrap: anywhere; }
  .fbx-change__text strong { color: var(--ink-900); font-weight: 600; }

  /* ---- The shared name + its manifest tooltip ------------------------------- */
  .fbx-jah { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-decoration: underline dotted; text-decoration-thickness: 1px; text-underline-offset: 3px; cursor: pointer; }
  .fbx-jah:hover, .fbx-jah[aria-expanded="true"] { color: var(--ink-900); text-decoration-style: solid; }
  .fbx-manifest { position: fixed; z-index: 9700; max-width: min(320px, calc(100vw - 16px)); padding: 12px 14px; border-radius: var(--radius-sm); background: var(--ink-900); color: #fff; box-shadow: var(--shadow-xl); font-size: 13px; line-height: 1.5; animation: fbx-fade var(--dur-fast) var(--ease-smooth); }
  .fbx-manifest[hidden] { display: none; }
  .fbx-manifest strong { display: block; margin-bottom: 4px; font-weight: 600; }
  .fbx-manifest p { margin: 0; color: rgba(255, 255, 255, 0.85); }

  /* ---- Lightbox ------------------------------------------------------------ */
  .fbx-lightbox { max-width: 94vw; max-height: 92vh; padding: 0; overflow: auto; border: 0; border-radius: var(--radius-md); background: #fff; box-shadow: var(--shadow-xl); }
  .fbx-lightbox::backdrop { background: rgba(26, 27, 38, 0.75); }
  .fbx-lightbox img { display: block; max-width: none; }
  .fbx-lightbox form { position: sticky; top: 0; height: 0; text-align: right; }
  .fbx-lightbox form button { width: 32px; height: 32px; margin: 8px; border: 0; border-radius: 50%; background: rgba(26, 27, 38, 0.7); color: #fff; font-size: 20px; line-height: 1; cursor: pointer; }

  /* ---- Smaller screens: list → detail ------------------------------------- */
  @media (max-width: 900px) {
    .fbx-panel { inset: 12px; }
    .fbx-split { grid-template-columns: minmax(0, 1fr); }
    .fbx-split:not(.is-detail) .fbx-detail { display: none; }
    .fbx-split.is-detail .fbx-list { display: none; }
    .fbx-back { display: inline-grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 1px solid var(--divider); border-radius: var(--radius-sm); background: #fff; color: var(--ink-700); cursor: pointer; }
    .fbx-detail__head { padding: 12px 16px; }
    .fbx-detail__actions { margin-left: 0; width: 100%; }
    .fbx-detail__body { padding: 16px; }
    .fbx-composer { padding: 12px 16px; }
    .fbx-shot { height: 200px; }
    .fbx-comment { font-size: 18px; }
    .fbx-bubble { max-width: 88%; }
    .fbx-timeline { padding: 24px 16px 32px; }
    .fbx-entry { grid-template-columns: 56px 16px minmax(0, 1fr); gap: 12px; }
    .fbx-entry__day { font-size: 26px; }
    .fbx-change { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  }
  @media (max-width: 600px) {
    .fbx-panel { inset: 0; border-radius: 0; }
    .fbx-head { flex-wrap: wrap; gap: 0; padding: 0 12px 0 4px; }
    .fbx-tabs { overflow-x: auto; }
    .fbx a.fbx-tab { min-height: 48px; padding: 0 10px; font-size: 14px; white-space: nowrap; }
    .fbx-head__end { width: 100%; justify-content: space-between; padding: 0 8px 8px; }
  }
</style>

<script>
  import { PSEUDONYM } from './manifest';

  type Comment = { date: string; author?: string; message: string; html?: string; pending?: boolean };
  type Entry = {
    id: string; name: string; page: string; message: string; status: string; createdAt: string;
    /** 'site': the change concerns every page; 'page' (or missing on older entries): only `page`. */
    scope?: 'page' | 'site';
    images: { name: string; url: string }[];
    comments?: Comment[];
    /** How the AI developer read the feedback (English), and the commit that addressed it. */
    interpretation?: { text: string; by?: string; date?: string; commit?: string };
    /** Interpretations proposed by the feedback-triage skill; the tester picks one. */
    proposals?: {
      by?: string; date?: string; recommended?: string; chosen?: string; chosenAt?: string;
      options: { key: string; title: string; interpretation: string; implementation?: string; effort?: string; vision?: string }[];
    };
    metadata?: {
      viewport?: { width: number; height: number };
      embeds?: { kind: 'youtube' | 'map' | 'iframe'; url: string; title?: string }[];
      screenshotFailed?: boolean;
    };
  };
  type Filter = 'new' | 'in_progress' | 'done' | 'all';
  type View = 'feedback' | 'changelog' | 'notes';

  const API = '/__feedback/api/entries';
  // Feedback is anonymous (PSEUDONYM); older entries may still carry a name, never shown.
  const STATUS_KEY: Record<string, Filter> = { New: 'new', 'In progress': 'in_progress', Done: 'done' };
  const FILTER_STATUS: Record<Filter, string> = { new: 'New', in_progress: 'In progress', done: 'Done', all: 'All' };
  // Old links (#new, #in-progress, …) still open the Feedback tab with that filter.
  const LEGACY_HASH: Record<string, Filter> = { '#new': 'new', '#in-progress': 'in_progress', '#done': 'done', '#all': 'all' };
  const EMBED_LABELS: Record<string, string> = { youtube: '▶ YouTube video', map: 'Map', iframe: 'Embed' };
  const FILTER_KEY = 'feedback-status-filter';
  const ICON = {
    check: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>',
    trash: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>',
    back: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>',
    open: '<svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>',
  };

  const $ = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const root = $('.fbx');
  const split = $('#feedback-view');
  const list = $('#entries');
  const detailItem = $('#detail');
  const detailHead = $('#detail-head');
  const detailBody = $('#detail-body');
  const composer = $<HTMLFormElement>('#composer');
  const composerInput = composer.querySelector('textarea')!;
  const composerStatus = composer.querySelector<HTMLElement>('.fbx-composer__status')!;
  const notePane = $('#note-pane');
  const lightbox = $<HTMLDialogElement>('#lightbox');

  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c]!);
  const linkify = (text: string) => escapeHtml(text).replace(/https?:\/\/[^\s<]+/g, (url) => `<a href="${url}" target="_blank" rel="noreferrer">${url}</a>`);
  const safeHref = (href: string) => (/^(\/|https?:\/\/)/.test(href) ? escapeHtml(href) : '');
  const time = (iso: string) => Date.parse(iso) || 0;
  const relative = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  function ago(iso: string) {
    const seconds = (time(iso) - Date.now()) / 1000;
    for (const [unit, size] of [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]] as const) {
      if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit);
    }
    return 'just now';
  }
  function shortAgo(iso: string) {
    const seconds = Math.max(0, (Date.now() - time(iso)) / 1000);
    for (const [unit, size] of [['y', 31536000], ['w', 604800], ['d', 86400], ['h', 3600], ['m', 60]] as const) {
      if (seconds >= size) return `${Math.floor(seconds / size)}${unit}`;
    }
    return 'now';
  }
  const nameButton = () => `<button type="button" class="fbx-jah" data-manifest aria-controls="jah-manifest" aria-expanded="false">${PSEUDONYM}</button>`;
  const readStorage = (key: string) => { try { return localStorage.getItem(key) || ''; } catch { return ''; } };
  const writeStorage = (key: string, value: string) => { try { localStorage.setItem(key, value); } catch { /* private mode */ } };

  // ---- State ----------------------------------------------------------------
  let entries: Entry[] = [];
  let loaded = false;
  let lastPayload = '';
  let statusFilter: Filter = (['new', 'in_progress', 'done', 'all'] as const).find((f) => f === readStorage(FILTER_KEY)) || 'new';
  let selectedId = '';
  let addingNote = false;
  const replyDraft = new Map<string, string>();

  function currentView(): View {
    if (location.hash === '#changelog') return 'changelog';
    if (location.hash === '#notes') return 'notes';
    return 'feedback';
  }
  if (LEGACY_HASH[location.hash]) {
    statusFilter = LEGACY_HASH[location.hash];
    history.replaceState(null, '', '#feedback');
  }
  const visibleEntries = () => (statusFilter === 'all' ? entries : entries.filter((entry) => STATUS_KEY[entry.status] === statusFilter));
  const selectedEntry = () => entries.find((entry) => entry.id === selectedId);
  const isNarrow = () => matchMedia('(max-width: 900px)').matches;

  // ---- Rendering --------------------------------------------------------------
  function render() {
    const view = currentView();
    document.querySelectorAll<HTMLAnchorElement>('[data-view]').forEach((tab) => {
      tab.classList.toggle('is-active', tab.dataset.view === view);
      if (tab.dataset.view === view) tab.setAttribute('aria-current', 'page'); else tab.removeAttribute('aria-current');
    });
    $('#feedback-view').hidden = view !== 'feedback';
    $('#changelog-view').hidden = view !== 'changelog';
    $('#notes-view').hidden = view !== 'notes';
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((chip) => {
      chip.classList.toggle('is-active', chip.dataset.filter === statusFilter);
      chip.setAttribute('aria-pressed', String(chip.dataset.filter === statusFilter));
    });
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((count) => {
      const status = count.dataset.count!;
      if (status === 'Notes') { count.textContent = notesLoaded && notes.length ? String(notes.length) : ''; return; }
      const n = status === 'All' ? entries.length : entries.filter((entry) => entry.status === status).length;
      count.textContent = loaded && n ? String(n) : '';
    });
    renderNotes();
    if (view !== 'feedback') return;
    renderList();
    renderDetail();
  }

  function renderList() {
    if (!loaded) return;
    const visible = visibleEntries();
    // Keep a valid selection on wide screens (the detail pane is always shown).
    if (!addingNote && !isNarrow() && !visible.some((entry) => entry.id === selectedId)) {
      stashDraft();
      selectedId = visible[0]?.id || '';
      restoreDraft();
    }
    const hadFocus = list.contains(document.activeElement);
    if (!visible.length) {
      list.innerHTML = `<p class="fbx-empty">${statusFilter === 'new' ? 'No new feedback. 🎉' : 'Nothing here.'}</p>`;
      return;
    }
    list.innerHTML = visible.map((entry) => {
      const shot = entry.images[0];
      const status = STATUS_KEY[entry.status] || 'new';
      return `<button type="button" class="fbx-row${entry.id === selectedId && !addingNote ? ' is-selected' : ''}" data-select="${entry.id}" aria-current="${entry.id === selectedId && !addingNote}">
          <span class="fbx-row__thumb">${shot ? `<img src="${shot.url}" alt="" loading="lazy">` : ''}</span>
          <span class="fbx-row__text">
            <span class="fbx-row__meta"><span class="fbx-sdot fbx-sdot--${status}" title="${entry.status}"></span><span class="fbx-row__path">${escapeHtml(entry.page || '—')}</span>${entry.scope === 'site' ? '<span class="fbx-scope">Every page</span>' : ''}<span class="fbx-row__time" title="${new Date(entry.createdAt).toLocaleString()}">${shortAgo(entry.createdAt)}</span></span>
            <span class="fbx-row__comment">${escapeHtml(entry.message.split('\n')[0])}</span>
          </span>
        </button>`;
    }).join('');
    if (hadFocus) list.querySelector<HTMLElement>('.fbx-row.is-selected')?.focus();
  }

  function renderThread(entry: Entry) {
    const comments = (entry.comments || []).filter((comment) => comment && typeof comment.message === 'string' && comment.message.trim());
    if (!comments.length) return '';
    return `<div class="fbx-thread">${[...comments].sort((a, b) => time(a.date) - time(b.date)).map((comment) => {
      const tester = comment.author === PSEUDONYM;
      return `<div class="fbx-bubble${tester ? ' fbx-bubble--tester' : ''}${comment.pending ? ' fbx-bubble--pending' : ''}">
          <div class="fbx-bubble__label">${tester ? nameButton() : escapeHtml(comment.author || 'Developer')} · ${comment.pending ? 'sending…' : `<time datetime="${escapeHtml(comment.date)}" title="${new Date(comment.date).toLocaleString()}">${ago(comment.date)}</time>`}</div>
          <div class="fbx-bubble__body">${comment.html ?? `<p>${linkify(comment.message)}</p>`}</div>
        </div>`;
    }).join('')}</div>`;
  }

  function renderDetail() {
    split.classList.toggle('is-detail', addingNote || !!selectedEntry());
    notePane.hidden = !addingNote;
    detailItem.hidden = addingNote;
    $('[data-add-note]').classList.toggle('is-active', addingNote);
    if (addingNote) return;
    const entry = selectedEntry();
    composer.hidden = !entry;
    if (!entry) {
      detailHead.innerHTML = '';
      detailBody.innerHTML = `<p class="fbx-empty">${loaded ? (visibleEntries().length ? 'Select feedback on the left.' : 'Nothing to show here.') : 'Loading feedback…'}</p>`;
      return;
    }
    const status = STATUS_KEY[entry.status] || 'new';
    const [shot, ...rest] = entry.images;
    const viewport = entry.metadata?.viewport;
    const chips = `${entry.page ? `<span class="fbx-shot__chip">${escapeHtml(entry.page)}</span>` : ''}${entry.scope === 'site' ? '<span class="fbx-shot__chip">Every page</span>' : ''}${viewport ? `<span class="fbx-shot__chip">${viewport.width}×${viewport.height}</span>` : ''}`;
    const openPage = entry.page && safeHref(entry.page) ? `<a class="fbx-shot__link" href="${safeHref(entry.page)}" target="_blank" rel="noreferrer">Open page ${ICON.open}</a>` : '';
    detailHead.innerHTML = `
      <button type="button" class="fbx-back" data-back aria-label="Back to the list">${ICON.back}</button>
      <span class="fbx-pill fbx-pill--${status}">${entry.status}</span>
      <span class="fbx-detail__meta">
        <span>${nameButton()} · <time datetime="${entry.createdAt}" title="${new Date(entry.createdAt).toLocaleString()}">${ago(entry.createdAt)}</time></span>
        ${(entry.metadata?.embeds || []).map((embed) => `<a href="${escapeHtml(embed.url)}" target="_blank" rel="noreferrer" title="${escapeHtml(embed.title || embed.url)}">${EMBED_LABELS[embed.kind] || 'Embed'} on screen</a>`).join('')}
        ${entry.scope === 'site' ? '<span class="fbx-scope" title="This feedback applies to every page, not just the one it was sent from">Applies to every page</span>' : ''}
        ${entry.metadata?.screenshotFailed ? '<span class="fbx-pill fbx-pill--danger">Screenshot failed</span>' : ''}
      </span>
      <span class="fbx-detail__actions">
        ${entry.status === 'New' ? '<button type="button" class="fbx-btn" data-progress>Mark in progress</button>' : ''}
        ${entry.status === 'In progress' ? `<button type="button" class="fbx-btn fbx-btn--primary" data-accept title="The change works: move this to Done">${ICON.check}Accept change</button>` : ''}
        <button type="button" class="fbx-icon-btn" data-delete aria-label="Delete" title="Delete">${ICON.trash}</button>
      </span>`;
    detailBody.innerHTML = `
      ${shot
        ? `<div class="fbx-shot"><button type="button" class="fbx-shot__open" data-zoom="${shot.url}" aria-label="Enlarge screenshot"><img src="${shot.url}" alt="Screenshot of ${escapeHtml(entry.page || 'the page')}"></button><span class="fbx-shot__chips">${chips}</span>${openPage}</div>`
        : `<div class="fbx-shot fbx-shot--none">No screenshot<span class="fbx-shot__chips">${chips}</span>${openPage}</div>`}
      ${rest.length ? `<div class="fbx-more">${rest.map((image) => `<button type="button" data-zoom="${image.url}" aria-label="Enlarge image"><img src="${image.url}" alt="" loading="lazy"></button>`).join('')}</div>` : ''}
      <p class="fbx-comment">${escapeHtml(entry.message)}</p>
      ${renderInterpretation(entry)}
      ${renderProposals(entry)}
      ${renderThread(entry)}`;
  }

  function renderProposals(entry: Entry) {
    const proposals = entry.proposals;
    const options = (proposals?.options || []).filter((option) => option && option.key && option.interpretation);
    if (!proposals || !options.length) return '';
    const locked = entry.status !== 'New';
    const intro = proposals.chosen
      ? (locked ? 'You chose the interpretation marked below; work on it has started.' : 'Thanks! You can still change your choice until work starts.')
      : 'The AI developer read your feedback in these ways. Pick the one that matches what you meant.';
    return `<section class="fbx-props" aria-label="Proposed interpretations">
        <div class="fbx-ai__label">Which interpretation fits? · ${escapeHtml(proposals.by || 'AI')}</div>
        <p class="fbx-props__intro">${intro}</p>
        ${options.map((option) => {
          const chosen = option.key === proposals.chosen;
          const chips = [
            option.key === proposals.recommended ? '<span class="fbx-props__chip fbx-props__chip--rec">Recommended</span>' : '',
            option.effort ? `<span class="fbx-props__chip" title="Effort">Effort ${escapeHtml(option.effort)}</span>` : '',
            option.vision ? `<span class="fbx-props__chip" title="Fit with the site vision">${escapeHtml(option.vision)}</span>` : '',
          ].join('');
          const action = chosen
            ? `<span class="fbx-props__chosen">${ICON.check}Chosen</span>`
            : locked ? '' : `<button type="button" class="fbx-btn${proposals.chosen ? '' : ' fbx-btn--primary'}" data-choose="${escapeHtml(option.key)}">This is what I mean</button>`;
          return `<article class="fbx-props__option${chosen ? ' is-chosen' : ''}">
              <div class="fbx-props__head"><span class="fbx-props__key">${escapeHtml(option.key)}</span><strong>${escapeHtml(option.title || '')}</strong>${chips}</div>
              <p class="fbx-props__text">${escapeHtml(option.interpretation)}</p>
              ${option.implementation ? `<details class="fbx-props__how"><summary>How we'd build it</summary><p>${escapeHtml(option.implementation)}</p></details>` : ''}
              ${action ? `<div class="fbx-props__action">${action}</div>` : ''}
            </article>`;
        }).join('')}
      </section>`;
  }

  function renderInterpretation(entry: Entry) {
    const ai = entry.interpretation;
    if (!ai?.text?.trim()) return '';
    const when = ai.date ? ` · <time datetime="${escapeHtml(ai.date)}" title="${new Date(ai.date).toLocaleString()}">${ago(ai.date)}</time>` : '';
    const commit = ai.commit && /^[0-9a-f]{7,40}$/.test(ai.commit)
      ? ` · <a href="https://github.com/StefVanremoortele/irie-vibes/commit/${ai.commit}" target="_blank" rel="noreferrer">fixed in ${ai.commit.slice(0, 7)}</a>`
      : '';
    return `<div class="fbx-ai">
        <div class="fbx-ai__label">AI interpretation · ${escapeHtml(ai.by || 'AI')}${when}${commit}</div>
        <p class="fbx-ai__text">${escapeHtml(ai.text)}</p>
      </div>`;
  }

  // ---- Data -------------------------------------------------------------------
  // Bumped by every change made here. A refresh that started before a change
  // finished is dropped, so it can't bring back a deleted item or an old status.
  let revision = 0;
  async function load() {
    const startedAt = revision;
    try {
      const response = await fetch(API, { cache: 'no-store' });
      if (!response.ok) throw new Error();
      const text = await response.text();
      if (startedAt !== revision) return;
      if (loaded && text === lastPayload) return; // nothing changed: keep the DOM (and scroll) as is
      lastPayload = text;
      entries = JSON.parse(text).entries;
      loaded = true;
      render();
    } catch {
      if (!loaded) list.innerHTML = '<p class="fbx-empty">The feedback service is unavailable.</p>';
    }
  }

  async function mutate(request: () => Promise<Response>, apply: () => void, undo: () => void, failure: string) {
    revision += 1;
    apply();
    render();
    const response = await request().catch(() => undefined);
    revision += 1;
    if (!response?.ok) {
      undo();
      render();
      const message = response ? (await response.json().catch(() => ({}))).error : '';
      alert(message || failure);
    }
    lastPayload = '';
    void load();
  }

  function select(id: string, focusRow = false) {
    stashDraft();
    selectedId = id;
    addingNote = false;
    restoreDraft();
    renderList();
    renderDetail();
    detailBody.scrollTop = 0;
    if (focusRow) list.querySelector<HTMLElement>('.fbx-row.is-selected')?.focus();
  }

  // When an item leaves the current filter (accepted, marked in progress,
  // deleted) its row collapses out first, then the next item is selected.
  async function leaveRow(id: string) {
    const visible = visibleEntries();
    const index = visible.findIndex((entry) => entry.id === id);
    const row = list.querySelector<HTMLElement>(`[data-select="${id}"]`);
    if (row && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      row.classList.add('is-leaving');
      await new Promise((resolve) => setTimeout(resolve, 260));
    }
    return visible[index + 1]?.id || visible[index - 1]?.id || '';
  }

  // ---- Feedback interactions ----------------------------------------------------
  list.addEventListener('click', (event) => {
    const row = (event.target as Element).closest<HTMLElement>('[data-select]');
    if (row) select(row.dataset.select!);
  });
  list.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
    event.preventDefault();
    const visible = visibleEntries();
    const index = visible.findIndex((entry) => entry.id === selectedId);
    const next = visible[Math.min(visible.length - 1, Math.max(0, index + (event.key === 'ArrowDown' ? 1 : -1)))];
    if (next) select(next.id, true);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((chip) => chip.addEventListener('click', () => {
    statusFilter = chip.dataset.filter as Filter;
    writeStorage(FILTER_KEY, statusFilter);
    if (isNarrow()) { stashDraft(); selectedId = ''; }
    render();
  }));
  $('[data-add-note]').addEventListener('click', () => {
    stashDraft();
    addingNote = true;
    renderList();
    renderDetail();
    notePane.querySelector('textarea')?.focus();
  });

  $('.fbx-detail').addEventListener('click', async (event) => {
    const target = event.target as Element;
    const bubbleImage = target.closest<HTMLImageElement>('.fbx-bubble__body img');
    if (bubbleImage) return openLightbox(bubbleImage.src);
    const button = target.closest<HTMLButtonElement>('button');
    if (!button) return;
    if (button.dataset.zoom) return openLightbox(button.dataset.zoom);
    if ('back' in button.dataset) {
      stashDraft();
      addingNote = false;
      selectedId = '';
      render();
      list.querySelector<HTMLElement>('.fbx-row')?.focus();
      return;
    }
    const entry = selectedEntry();
    if (!entry) return;
    const id = entry.id;
    if ('progress' in button.dataset || 'accept' in button.dataset) {
      const accepting = 'accept' in button.dataset;
      if (accepting && !confirm('Accept this change? It moves to Done.')) return;
      const next = accepting ? 'Done' : 'In progress';
      const before = entry.status;
      const leaves = statusFilter !== 'all' && FILTER_STATUS[statusFilter] !== next;
      const nextId = leaves ? await leaveRow(id) : id;
      await mutate(
        () => fetch(`${API}/${id}/${accepting ? 'accept' : 'progress'}`, { method: 'POST' }),
        () => { entry.status = next; if (leaves) { stashDraft(); selectedId = nextId; restoreDraft(); } },
        () => { entry.status = before; selectedId = id; },
        accepting ? 'Could not accept this change.' : 'Could not mark this in progress.',
      );
      return;
    }
    if (button.dataset.choose && entry.proposals) {
      const proposals = entry.proposals;
      const before = { chosen: proposals.chosen, chosenAt: proposals.chosenAt };
      const option = button.dataset.choose;
      await mutate(
        () => fetch(`${API}/${id}/choose`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ option }) }),
        () => { proposals.chosen = option; proposals.chosenAt = new Date().toISOString(); },
        () => { proposals.chosen = before.chosen; proposals.chosenAt = before.chosenAt; },
        'Could not save your choice.',
      );
      return;
    }
    if ('delete' in button.dataset) {
      if (!confirm('Delete this feedback? This can’t be undone.')) return;
      const removed = entry;
      const nextId = await leaveRow(id);
      await mutate(
        () => fetch(`${API}/${id}`, { method: 'DELETE' }),
        () => { entries = entries.filter((item) => item.id !== id); replyDraft.delete(id); selectedId = nextId; restoreDraft(); },
        () => { if (!entries.some((item) => item.id === id)) entries = [...entries, removed].sort((a, b) => b.createdAt.localeCompare(a.createdAt)); selectedId = id; },
        'Could not delete this feedback.',
      );
    }
  });

  // ---- Reply composer (one static field; drafts are kept per item) -------------
  function stashDraft() {
    if (selectedId) replyDraft.set(selectedId, composerInput.value);
  }
  function restoreDraft() {
    composerInput.value = replyDraft.get(selectedId) || '';
    composerStatus.textContent = '';
    autosize();
  }
  function autosize() {
    composerInput.style.height = 'auto';
    composerInput.style.height = `${Math.min(140, composerInput.scrollHeight + 2)}px`;
  }
  composerInput.addEventListener('input', () => { replyDraft.set(selectedId, composerInput.value); autosize(); });
  composerInput.addEventListener('keydown', (event) => {
    // Enter sends, Shift+Enter adds a new line.
    if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
      event.preventDefault();
      composer.requestSubmit();
    }
  });
  composer.addEventListener('submit', async (event) => {
    event.preventDefault();
    const entry = selectedEntry();
    const text = composerInput.value.trim();
    if (!entry || !text) return;
    const id = entry.id;
    const pending: Comment = { date: new Date().toISOString(), author: PSEUDONYM, message: text, pending: true };
    entry.comments = [...(entry.comments || []), pending];
    replyDraft.delete(id);
    composerInput.value = '';
    composerStatus.textContent = '';
    autosize();
    revision += 1;
    renderDetail();
    detailBody.scrollTop = detailBody.scrollHeight;
    try {
      const response = await fetch(`${API}/${id}/replies`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: text }) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Could not send the reply.');
      entries = entries.map((item) => (item.id === id ? result.entry : item));
    } catch (error) {
      entry.comments = (entry.comments || []).filter((comment) => comment !== pending);
      replyDraft.set(id, text);
      if (selectedId === id) {
        composerInput.value = text;
        composerStatus.textContent = error instanceof Error ? error.message : 'Could not send the reply.';
        autosize();
      }
    } finally {
      revision += 1;
      lastPayload = '';
      if (selectedId === id) renderDetail();
    }
  });

  // ---- Lightbox -----------------------------------------------------------------
  function openLightbox(src: string) {
    lightbox.querySelector('img')!.src = src;
    lightbox.showModal();
  }
  lightbox.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });

  // ---- Close: Esc, the scrim or the Esc chip go back to the site --------------------
  function close() {
    if (root.classList.contains('is-closing')) return;
    root.classList.add('is-closing');
    const fromSite = document.referrer.startsWith(location.origin) && !new URL(document.referrer).pathname.startsWith('/feedback');
    setTimeout(() => { if (fromSite && history.length > 1) history.back(); else location.href = '/'; }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 240);
  }
  document.querySelectorAll('[data-close]').forEach((element) => element.addEventListener('click', close));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || lightbox.open || event.defaultPrevented) return;
    if (!manifest.hidden) { hideManifest(); return; }
    const field = document.activeElement;
    // Esc in a text field first leaves the field.
    if (field instanceof HTMLTextAreaElement || field instanceof HTMLInputElement) { field.blur(); return; }
    close();
  });

  // ---- The shared name: click pins the manifest tooltip, hover previews it ----------
  const manifest = $('#jah-manifest');
  let manifestAnchor: HTMLElement | null = null;
  let manifestPinned = false;
  function placeManifest() {
    if (!manifestAnchor || !document.contains(manifestAnchor)) { hideManifest(); return; }
    const anchor = manifestAnchor.getBoundingClientRect();
    const box = manifest.getBoundingClientRect();
    const below = anchor.bottom + 8;
    const top = below + box.height > innerHeight - 8 ? Math.max(8, anchor.top - 8 - box.height) : below;
    const left = Math.min(Math.max(8, anchor.left), innerWidth - box.width - 8);
    manifest.style.top = `${top}px`;
    manifest.style.left = `${left}px`;
  }
  function showManifest(anchor: HTMLElement, pin: boolean) {
    manifestAnchor = anchor;
    manifestPinned = pin;
    manifest.hidden = false;
    placeManifest();
    document.querySelectorAll('[data-manifest]').forEach((button) => button.setAttribute('aria-expanded', String(pin && button === anchor)));
  }
  function hideManifest() {
    manifest.hidden = true;
    manifestAnchor = null;
    manifestPinned = false;
    document.querySelectorAll('[data-manifest]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
  }
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-manifest]');
    if (button) {
      if (manifestPinned && manifestAnchor === button) hideManifest(); else showManifest(button, true);
      return;
    }
    if (!manifest.hidden && !manifest.contains(event.target as Node)) hideManifest();
  });
  root.addEventListener('mouseover', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-manifest]');
    if (button && !manifestPinned) showManifest(button, false);
  });
  root.addEventListener('mouseout', (event) => {
    const button = (event.target as Element).closest<HTMLElement>('[data-manifest]');
    if (button && !manifestPinned && !button.contains(event.relatedTarget as Node)) hideManifest();
  });
  window.addEventListener('resize', () => { if (!manifest.hidden) placeManifest(); });
  document.addEventListener('scroll', () => { if (!manifest.hidden) placeManifest(); }, true);

  // ---- Developer notes (CMS) ---------------------------------------------------------
  type Note = { title: string; date: string; author?: string; message: string; page?: string };
  const notesList = $('#notes-list');
  let notes: Note[] = [];
  let notesLoaded = false;
  // Notes newer than this browser's last visit to the tab get a "New" pill.
  const SEEN_KEY = 'feedback-notes-seen';
  let seenBefore = readStorage(SEEN_KEY);
  const dayParts = (iso: string) => {
    const date = new Date(/^\d{4}-\d{2}-\d{2}$/.test(iso) ? `${iso}T12:00:00` : iso);
    return Number.isNaN(date.getTime()) ? { day: '', month: '' } : { day: String(date.getDate()), month: date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) };
  };
  const dateColumn = (iso: string) => { const { day, month } = dayParts(iso); return `<div class="fbx-entry__date"><span class="fbx-entry__day">${day}</span><span class="fbx-entry__month">${month}</span></div><div class="fbx-entry__rail" aria-hidden="true"></div>`; };

  function renderNotes() {
    const seen = time(seenBefore);
    $('[data-count="Notes"]').classList.toggle('has-unseen', notes.some((note) => time(note.date) > seen));
    if (!notesLoaded) return;
    if (currentView() === 'notes' && notes[0]) writeStorage(SEEN_KEY, notes[0].date);
    notesList.innerHTML = notes.length ? notes.map((note) => `<article class="fbx-entry">
        ${dateColumn(note.date)}
        <div class="fbx-entry__content">
          <h2 class="fbx-entry__title">${escapeHtml(note.title || '')}${time(note.date) > seen ? '<span class="fbx-pill fbx-pill--new">New</span>' : ''}</h2>
          <div class="fbx-entry__meta"><span>${escapeHtml(note.author || 'Developer')}</span>${note.page && safeHref(note.page) ? `<a href="${safeHref(note.page)}">${escapeHtml(note.page)}</a>` : ''}</div>
          <div class="fbx-entry__body fbx-entry__body--plain">${linkify(note.message)}</div>
        </div>
      </article>`).join('') : '<p class="fbx-empty">No notes from the developer yet.</p>';
  }

  async function loadNotes() {
    try {
      const response = await fetch('/__feedback/api/notes', { cache: 'no-store' });
      if (!response.ok) throw new Error();
      notes = (await response.json()).notes;
      notesLoaded = true;
      renderNotes();
      render();
    } catch {
      if (!notesLoaded) notesList.innerHTML = '<p class="fbx-empty">Notes are unavailable.</p>';
    }
  }

  // ---- Changelog (structured entries from the CMS, rendered by the server) ---------
  type ChangelogEntry = { date: string; title: string; status?: string; html: string; items: { tag: string; title: string; html: string }[] };
  const changelogBody = $('#changelog-body');
  let changelogLoaded = false;
  let changelogPayload = '';
  const tagClass = (tag: string) => `fbx-tag fbx-tag--${tag.toLowerCase().replace(/[^a-z]+/g, '-')}`;
  async function loadChangelog() {
    try {
      const response = await fetch('/__feedback/api/changelog', { cache: 'no-store' });
      if (!response.ok) throw new Error();
      const text = await response.text();
      if (text === changelogPayload) return;
      changelogPayload = text;
      const { entries: items = [], html = '' } = JSON.parse(text) as { entries?: ChangelogEntry[]; html?: string };
      const timeline = items.map((entry) => `<article class="fbx-entry">
          ${dateColumn(entry.date)}
          <div class="fbx-entry__content">
            <h2 class="fbx-entry__title">${escapeHtml(entry.title)}${entry.status ? `<span class="fbx-pill fbx-pill--warn">${escapeHtml(entry.status)}</span>` : ''}</h2>
            ${entry.html ? `<div class="fbx-entry__body">${entry.html}</div>` : ''}
            ${entry.items.length ? `<div class="fbx-changes">${entry.items.map((item) => `<div class="fbx-change">${item.tag ? `<span class="${tagClass(item.tag)}">${escapeHtml(item.tag)}</span>` : '<span></span>'}<div class="fbx-change__text">${item.title ? `<strong>${escapeHtml(item.title)}</strong> ` : ''}${item.html}</div></div>`).join('')}</div>` : ''}
          </div>
        </article>`).join('');
      // Older single-markdown changelog (before it was converted to entries).
      const legacy = html ? `<div class="fbx-entry__body">${html}</div>` : '';
      changelogBody.innerHTML = timeline || legacy || '<p class="fbx-empty">Nothing in the changelog yet.</p>';
      changelogLoaded = true;
    } catch {
      if (!changelogLoaded) changelogBody.innerHTML = '<p class="fbx-empty">The changelog is unavailable right now.</p>';
    }
  }

  // ---- "Site updated" (relative; exact date in the tooltip) -------------------------
  const updated = $<HTMLTimeElement>('#last-updated');
  function renderUpdated() {
    updated.textContent = ago(updated.dateTime);
    updated.title = new Date(updated.dateTime).toLocaleString();
  }
  renderUpdated();
  setInterval(renderUpdated, 60000);

  window.addEventListener('hashchange', () => {
    if (LEGACY_HASH[location.hash]) { statusFilter = LEGACY_HASH[location.hash]; history.replaceState(null, '', '#feedback'); }
    seenBefore = readStorage(SEEN_KEY);
    render();
  });
  matchMedia('(max-width: 900px)').addEventListener('change', render);

  const refresh = () => { void load(); void loadNotes(); void loadChangelog(); };
  window.addEventListener('focus', refresh);
  setInterval(() => { if (document.visibilityState === 'visible') refresh(); }, 30000);
  render();
  refresh();

  // ---- Add a note without a screenshot ----------------------------------------------
  const form = $<HTMLFormElement>('#feedback-form');
  const fileInput = $<HTMLInputElement>('#image-input');
  const dropzone = $('#dropzone');
  const previews = $('#previews');
  const formStatus = $('#form-status');
  const files: File[] = [];

  function renderPreviews() {
    previews.replaceChildren(...files.map((file, index) => {
      const item = document.createElement('div');
      item.className = 'preview';
      const image = document.createElement('img');
      image.src = URL.createObjectURL(file);
      image.alt = file.name;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.setAttribute('aria-label', `Remove ${file.name}`);
      remove.addEventListener('click', () => { files.splice(index, 1); renderPreviews(); });
      item.append(image, remove);
      return item;
    }));
  }
  function addFiles(fileList: FileList | null | undefined) {
    for (const file of fileList || []) if (file.type.startsWith('image/') && files.length < 10) files.push(file);
    renderPreviews();
  }
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); fileInput.click(); } });
  fileInput.addEventListener('change', () => addFiles(fileInput.files));
  ['dragenter', 'dragover'].forEach((name) => dropzone.addEventListener(name, (event) => { event.preventDefault(); dropzone.classList.add('is-over'); }));
  ['dragleave', 'drop'].forEach((name) => dropzone.addEventListener(name, (event) => { event.preventDefault(); dropzone.classList.remove('is-over'); }));
  dropzone.addEventListener('drop', (event) => addFiles((event as DragEvent).dataTransfer?.files));
  form.addEventListener('paste', (event) => addFiles(event.clipboardData?.files));

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    formStatus.textContent = 'Sending…';
    const data = new FormData(form);
    files.forEach((file) => data.append('images', file));
    try {
      const response = await fetch(API, { method: 'POST', body: data });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || (response.status === 413 ? 'Too large: the public site accepts about 1 MB per note. Use fewer or smaller images.' : 'Could not add the note.'));
      form.reset();
      files.splice(0);
      renderPreviews();
      formStatus.textContent = '';
      statusFilter = 'new';
      writeStorage(FILTER_KEY, statusFilter);
      lastPayload = '';
      await load();
      select(result.entry.id);
    } catch (error) {
      formStatus.textContent = error instanceof Error ? error.message : 'Could not add the note.';
    }
  });
</script>
