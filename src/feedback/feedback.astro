---
import { execFileSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';
import { MANIFEST_TEXT, MANIFEST_TITLE } from './manifest';

// When the website (code, not content) last changed: the date of the latest
// commit that touches anything outside the CMS-owned paths, so content edits
// and media uploads from the Sveltia admin (also commits on main) don't count.
// Falls back to the build time outside a git checkout.
const CMS_PATHS = [':(exclude)content', ':(exclude)public/assets'];
let lastUpdated = new Date().toISOString();
try {
  lastUpdated = execFileSync('git', ['log', '-1', '--format=%cI', '--', '.', ...CMS_PATHS], { encoding: 'utf8' }).trim() || lastUpdated;
} catch {
  // Not a git checkout: keep the build time.
}
---

<!--
  Testing page (/feedback): a dialog over the real homepage (shown inert behind
  a dark scrim). The dialog is a tester tool with its own design tokens (Pane,
  scoped to .fbx) and deliberately does NOT follow the festival design system;
  see README "Feedback tool". Tabs: Feedback (inbox split: list + detail),
  Changelog (timeline) and Developer notes. Layout and states follow the
  "Feedback inbox redesign" handoff (2026-10-28).
-->
<Base title="Testing" description="Website feedback, changelog and developer notes for testers" noIndex>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />

  <div class="inbox-behind" inert aria-hidden="true"><HomeContent /></div>

  <div class="fbx-exit-white" aria-hidden="true"></div>
  <div class="fbx" data-exit-speed="1">
    <div class="fbx-scrim" data-close aria-hidden="true"></div>
    <section class="fbx-panel" role="dialog" aria-modal="true" aria-labelledby="fbx-title">
      <h1 id="fbx-title" class="fbx-sr">Testing</h1>
      <header class="fbx-head">
        <nav class="fbx-tabs" aria-label="Sections">
          <a class="fbx-tab" href="#feedback" data-view="feedback">Feedback <span class="fbx-count fbx-count--accent" data-count="New"></span></a>
          <a class="fbx-tab" href="#changelog" data-view="changelog">Changelog</a>
          <a class="fbx-tab" href="#notes" data-view="notes">Developer notes <span class="fbx-count" data-count="Notes"></span></a>
        </nav>
        <div class="fbx-head__end">
          <span class="fbx-updated"><span class="fbx-dot" aria-hidden="true"></span><span>Site updated <time id="last-updated" datetime={lastUpdated}>{new Date(lastUpdated).toUTCString()}</time></span></span>
          <button type="button" class="fbx-close" data-close title="Close (Esc)">Close <kbd>Esc</kbd></button>
        </div>
      </header>

      <!-- Feedback: inbox split -->
      <div id="feedback-view" class="fbx-view fbx-split">
        <aside class="fbx-list" aria-label="Feedback list">
          <div class="fbx-chips" role="group" aria-label="Filter by status">
            <button type="button" class="fbx-chip" data-filter="new">Triage <span data-count="New"></span></button>
            <button type="button" class="fbx-chip" data-filter="in_progress">In progress <span data-count="In progress"></span></button>
            <button type="button" class="fbx-chip" data-filter="done">Processed <span data-count="Done"></span></button>
          </div>
          <div id="entries" class="fbx-rows" aria-live="polite"><p class="fbx-empty">Loading feedback…</p></div>
          <div class="fbx-addnote-wrap">
            <button type="button" class="fbx-addnote" data-add-note>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              Add a note without a screenshot
            </button>
          </div>
        </aside>

        <div class="fbx-detail">
          <div id="detail" class="fbx-detail__item">
            <header class="fbx-detail__head" id="detail-head"></header>
            <div class="fbx-detail__body" id="detail-body"><p class="fbx-empty">Select feedback on the left.</p></div>
            <form class="fbx-composer" id="composer" hidden>
              <textarea name="message" rows="1" maxlength="5000" required placeholder="Reply to the developer…" aria-label="Reply to the developer"></textarea>
              <button type="submit" class="fbx-btn fbx-btn--dark">Send</button>
              <p class="fbx-composer__status" role="status"></p>
            </form>
          </div>

          <!-- Add a note without a screenshot -->
          <div id="note-pane" class="fbx-detail__item" hidden>
            <header class="fbx-detail__head">
              <button type="button" class="fbx-back" data-back aria-label="Back to the list"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg></button>
              <h2 class="fbx-detail__title">Add a note without a screenshot</h2>
            </header>
            <form id="feedback-form" class="fbx-detail__body fbx-noteform">
              <label class="fbx-field">Comment<textarea name="message" required maxlength="10000" rows="4" placeholder="Describe what you noticed…"></textarea></label>
              <label class="fbx-field">Page <span>(optional)</span><input name="page" maxlength="500" placeholder="/tickets" /></label>
              <div class="fbx-dropzone" id="dropzone" tabindex="0" role="button" aria-label="Add images">
                Drop or paste images here, or <button type="button" id="pick-images">choose files</button>
                <input id="image-input" type="file" accept="image/*" multiple hidden />
              </div>
              <div class="fbx-previews" id="previews"></div>
              <div class="fbx-noteform__actions"><button class="fbx-btn fbx-btn--primary" type="submit">Add note</button><p id="form-status" role="status"></p></div>
            </form>
          </div>
        </div>
      </div>

      <!-- Changelog: timeline -->
      <div id="changelog-view" class="fbx-view fbx-scroll" hidden>
        <div id="changelog-body" class="fbx-timeline" aria-live="polite"><p class="fbx-empty">Loading changelog…</p></div>
      </div>

      <!-- Developer notes: same timeline -->
      <div id="notes-view" class="fbx-view fbx-scroll" hidden>
        <div id="notes-list" class="fbx-timeline" aria-live="polite"><p class="fbx-empty">Loading notes…</p></div>
      </div>
    </section>
    <div class="fbx-exit-title" aria-hidden="true"></div>
    <div id="jah-manifest" class="fbx-manifest" role="tooltip" hidden><strong>{MANIFEST_TITLE}</strong><p>{MANIFEST_TEXT}</p></div>
  </div>

  <dialog id="lightbox" class="fbx fbx-lightbox"><form method="dialog"><button aria-label="Close">×</button></form><img alt="" /></dialog>
</Base>

<style is:global>
  /* ---- Tokens (Pane design system), scoped to the dialog ------------------ */
  .fbx {
    --ink-900: #1a1b26; --ink-700: #2e2f3e; --ink-500: #5b5c6e; --ink-400: #8b8c9e; --ink-300: #b8b9c8; --ink-200: #d8d9e3;
    --divider: rgba(26, 27, 38, 0.10);
    --accent-500: #7c5cff; --accent-600: #6b49f0; --accent-400: #9d82ff; --accent-100: #ece6ff; --accent-tint: rgba(124, 92, 255, 0.12);
    --success-500: #10b981; --success-100: #d1fae5; --success-700: #047857;
    --warn-500: #f59e0b; --warn-100: #fef3c7; --warn-700: #92600a;
    --info-500: #3b82f6; --info-100: #dbeafe; --info-700: #1d4ed8;
    --warn-800: #92400e;
    --glass-tint-high: rgba(255, 255, 255, 0.72); --glass-tint-med: rgba(255, 255, 255, 0.55); --glass-tint-low: rgba(255, 255, 255, 0.38);
    --glass-border: rgba(255, 255, 255, 0.65); --glass-edge-dark: rgba(26, 27, 38, 0.08);
    --danger-500: #ef4444; --danger-100: #fee2e2;
    --radius-xs: 6px; --radius-sm: 10px; --radius-md: 14px; --radius-lg: 20px; --radius-pill: 999px;
    --shadow-sm: 0 1px 2px rgba(26, 27, 38, 0.04), 0 2px 8px rgba(26, 27, 38, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    --shadow-md: 0 2px 4px rgba(26, 27, 38, 0.04), 0 8px 24px rgba(26, 27, 38, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.7);
    --shadow-xl: 0 8px 16px rgba(26, 27, 38, 0.06), 0 40px 80px rgba(26, 27, 38, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    --shadow-focus: 0 0 0 3px rgba(124, 92, 255, 0.35);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1); --ease-smooth: cubic-bezier(0.32, 0.72, 0, 1);
    --dur-fast: 140ms; --dur-med: 260ms; --dur-slow: 420ms;
    --font-display: 'Fraunces', 'Iowan Old Style', 'Palatino', Georgia, serif;
    --font-body: 'Inter Tight', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    --font-mono: 'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace;
    color: var(--ink-700);
    font: 400 15px/1.5 var(--font-body);
    letter-spacing: normal;
    text-transform: none;
    -webkit-font-smoothing: antialiased;
  }
  .fbx *, .fbx *::before, .fbx *::after { box-sizing: border-box; }
  .fbx :where(button, input, textarea) { font: inherit; color: inherit; }
  .fbx :where(a) { color: var(--accent-600); }
  .fbx svg { flex: none; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .fbx-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .fbx :focus-visible { outline: none; box-shadow: var(--shadow-focus); }

  /* ---- Shell: scrim + panel over the inert homepage ----------------------- */
  html:has(.fbx-panel) { overflow: hidden; }
  .inbox-behind { width: 100%; }
  .fbx-scrim { position: fixed; inset: 0; z-index: 9500; background: radial-gradient(120% 90% at 0% 0%, #fde2e4 0%, transparent 55%), radial-gradient(100% 80% at 100% 0%, #bae6fd 0%, transparent 60%), radial-gradient(120% 100% at 100% 100%, #e9d5ff 0%, transparent 55%), radial-gradient(100% 90% at 0% 100%, #fef3c7 0%, transparent 55%), linear-gradient(180deg, rgba(250, 250, 255, 0.92) 0%, rgba(243, 241, 255, 0.92) 100%); opacity: 0.85; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); animation: fbx-fade var(--dur-slow) var(--ease-smooth); }
  .fbx-panel { position: fixed; inset: 24px; z-index: 9600; max-width: 1360px; margin: 0 auto; display: grid; grid-template-rows: auto minmax(0, 1fr); overflow: hidden; background: var(--glass-tint-high); -webkit-backdrop-filter: blur(24px) saturate(180%); backdrop-filter: blur(24px) saturate(180%); border: 1px solid var(--glass-border); border-bottom-color: var(--glass-edge-dark); border-radius: 14px; will-change: transform, opacity, filter; box-shadow: var(--shadow-xl); animation: fbx-enter var(--dur-slow) var(--ease-smooth); }
  .fbx-exit-white { display: none; position: fixed; inset: 0; z-index: 9499; background: white; }
  body:has(.fbx.is-closing) .fbx-exit-white { display: block; }
  .fbx.is-closing { position: fixed; inset: 0; z-index: 9500; overflow: hidden; background: radial-gradient(120% 90% at 0% 0%, #fde2e4 0%, transparent 55%), radial-gradient(100% 80% at 100% 0%, #bae6fd 0%, transparent 60%), radial-gradient(120% 100% at 100% 100%, #e9d5ff 0%, transparent 55%), radial-gradient(100% 90% at 0% 100%, #fef3c7 0%, transparent 55%), linear-gradient(180deg, #fafaff 0%, #f3f1ff 100%); }
  .fbx.is-closing .fbx-panel { animation: none; pointer-events: none; }
  .fbx.is-closing .fbx-scrim { animation: none; background: rgba(26,27,38,0.12); opacity: 1; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .fbx-exit-title { display: none; position: absolute; inset: 0; z-index: 9700; align-items: center; justify-content: center; pointer-events: none; font-family: 'Fraunces', Georgia, serif; font-weight: 400; font-size: clamp(36px, 7vw, 104px); letter-spacing: 0.08em; color: #1a1b26; white-space: nowrap; }
  .fbx.is-closing .fbx-exit-title { display: flex; }
  @media (max-width: 600px) { .fbx-exit-title { font-size: 6vw; } }
  @keyframes fbx-fade { from { opacity: 0; } }
  @keyframes fbx-enter { from { opacity: 0; transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) {
    .fbx-panel { animation-name: fbx-fade; }
    .fbx *, .fbx *::before, .fbx *::after { transition-duration: 0s !important; }
  }

  /* Header: tabs left, "site updated" + Esc right */
  .fbx-head { display: flex; align-items: stretch; justify-content: space-between; gap: 24px; min-height: 60px; padding: 0 24px; border-bottom: 1px solid var(--divider); }
  .fbx-tabs { display: flex; align-items: stretch; }
  .fbx a.fbx-tab { display: inline-flex; align-items: center; gap: 8px; padding: 0 12px; color: var(--ink-500); font-size: 15px; font-weight: 500; text-decoration: none; transition: color var(--dur-fast); }
  .fbx a.fbx-tab:hover { color: var(--ink-900); }
  .fbx a.fbx-tab.is-active { color: var(--ink-900); font-weight: 600; box-shadow: inset 0 -2px 0 var(--accent-500); }
  .fbx a.fbx-tab:focus-visible { box-shadow: inset 0 0 0 3px rgba(124, 92, 255, 0.35); border-radius: var(--radius-xs); }
  .fbx-count { padding: 1px 7px; border-radius: var(--radius-pill); background: var(--ink-200); color: var(--ink-700); font-size: 12px; font-weight: 600; line-height: 1.4; }
  .fbx-count--accent, .fbx-count.has-unseen { background: var(--accent-500); color: #fff; }
  .fbx-count:empty { display: none; }
  .fbx-head__end { display: flex; align-items: center; gap: 24px; }
  .fbx-updated { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-500); font-size: 13px; white-space: nowrap; }
  .fbx-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success-500); }
  .fbx-close { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border: 1px solid var(--divider); border-radius: var(--radius-xs); background: var(--glass-tint-med); color: var(--ink-500); font-size: 12px; cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast); }
  .fbx-close:hover { background: var(--glass-tint-high); color: var(--ink-900); }
  .fbx-close kbd { font: inherit; font-family: var(--font-mono); }

  /* Background-runner indicator (handoff runner-frame.css): shown while runners work */
  @property --runner-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  @keyframes runner-spin { to { --runner-angle: 360deg; } }
  @keyframes runner-breathe { 0%, 100% { opacity: 0.3; } 45% { opacity: 1; } }
  .runner-frame { position: absolute; inset: 0; z-index: 5; border-radius: inherit; pointer-events: none; }
  .runner-frame--aurora { padding: 2px; background: conic-gradient(from var(--runner-angle), #f9a8d4, #c4b5fd, #a5b4fc, #7dd3fc, #fcd34d, #f9a8d4); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); animation: runner-spin 16s linear infinite, runner-breathe 5s ease-in-out infinite; }
  .runner-frame--halo { box-shadow: inset 0 0 0 1.5px rgba(124, 92, 255, 0.55), inset 0 0 40px rgba(124, 92, 255, 0.18); animation: runner-breathe 5s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .runner-frame { animation: runner-breathe 5s ease-in-out infinite !important; } }

  .fbx-view { min-height: 0; }
  .fbx-view[hidden] { display: none; }
  .fbx-scroll { overflow-y: auto; overscroll-behavior: contain; }
  .fbx-empty { margin: 0; padding: 24px; color: var(--ink-400); font-size: 14px; text-align: center; }

  /* ---- Feedback: inbox split ---------------------------------------------- */
  .fbx-split { display: grid; grid-template-columns: minmax(300px, 380px) minmax(0, 1fr); }
  .fbx-list { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; min-height: 0; background: var(--glass-tint-low); border-right: 1px solid var(--divider); }
  .fbx-chips { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px; }
  .fbx-chip { display: inline-flex; align-items: center; justify-content: center; flex: 1 0 auto; min-height: 40px; gap: 5px; padding: 7px 10px; border: 1px solid var(--divider); border-radius: var(--radius-pill); background: transparent; color: var(--ink-500); font-size: 15px; font-weight: 500; cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast); }
  .fbx-chip:hover { color: var(--ink-900); }
  .fbx-chip.is-active { border-color: rgba(124, 92, 255, 0.35); background: var(--accent-tint); color: var(--accent-600); }
  .fbx-chip span { opacity: 0.7; }
  .fbx-chip span:empty { display: none; }
  .fbx-rows { display: flex; flex-direction: column; gap: 4px; padding: 0 10px 10px; overflow-y: auto; overscroll-behavior: contain; }
  .fbx-row { display: flex; gap: 12px; align-items: flex-start; width: 100%; padding: 12px; border: 1px solid transparent; border-radius: var(--radius-sm); background: transparent; text-align: left; cursor: pointer; transition: background var(--dur-fast), border-color var(--dur-fast), box-shadow var(--dur-fast); }
  .fbx-row:hover { background: var(--glass-tint-high); }
  .fbx-row.is-selected { border-color: var(--accent-500); background: var(--glass-tint-high); box-shadow: var(--shadow-sm); }
  .fbx-row.is-selected:focus-visible { box-shadow: var(--shadow-sm), var(--shadow-focus); }
  .fbx-row.is-leaving { animation: fbx-leave var(--dur-med) var(--ease-smooth) forwards; }
  @keyframes fbx-leave { to { opacity: 0; transform: translateX(-12px); } }
  .fbx-row__thumb { width: 48px; height: 40px; flex: none; overflow: hidden; border: 1px solid var(--divider); border-radius: var(--radius-xs); background: var(--glass-tint-high); }
  .fbx-row__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .fbx-row__text { display: flex; flex: 1; flex-direction: column; gap: 5px; min-width: 0; }
  .fbx-row__comment { display: -webkit-box; overflow: hidden; color: var(--ink-900); font-size: 13px; font-weight: 500; line-height: 1.35; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
  .fbx-row--new .fbx-row__comment { font-weight: 600; }
  .fbx-row__meta { display: flex; align-items: center; gap: 6px; min-width: 0; color: var(--ink-400); font-size: 12px; }
  .fbx-row__path { min-width: 0; overflow: hidden; font-family: var(--font-mono); text-overflow: ellipsis; white-space: nowrap; }
  .fbx-row__time { flex: none; white-space: nowrap; }
  .fbx-sdot { flex: none; width: 6px; height: 6px; margin: 0 2px; border-radius: 50%; background: var(--ink-300); }
  .fbx-sdot--new { background: var(--accent-500); }
  .fbx-sdot--choice { width: 10px; height: 10px; background: var(--accent-500); box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.22); }
  .fbx-addnote-wrap { padding: 12px 16px 16px; border-top: 1px solid var(--divider); }
  .fbx-addnote { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 11px; border: 1px dashed var(--ink-300); border-radius: var(--radius-sm); background: transparent; color: var(--ink-500); font-size: 13px; font-weight: 500; cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast); }
  .fbx-addnote:hover, .fbx-addnote.is-active { background: var(--glass-tint-med); color: var(--ink-900); }
  .fbx-addnote svg { stroke-width: 1.5; }

  .fbx-detail { min-height: 0; min-width: 0; }
  .fbx-detail__item { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; height: 100%; min-height: 0; }
  .fbx-detail__item[hidden] { display: none; }
  .fbx-detail__head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; padding: 14px 32px; border-bottom: 1px solid var(--divider); }
  .fbx-detail__head:empty { display: none; }
  .fbx-detail__meta { min-width: 0; color: var(--ink-500); font-size: 13px; }
  .fbx-detail__meta .fbx-jah { color: var(--accent-500); text-decoration: none; }
  .fbx-detail__meta .fbx-jah:hover, .fbx-detail__meta .fbx-jah[aria-expanded="true"] { color: var(--accent-600); text-decoration: underline; }
  .fbx-detail__title { margin: 0; color: var(--ink-900); font: 600 15px/1.3 var(--font-body); }
  .fbx-detail__actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .fbx-detail__body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .fbx-detail__inner { display: flex; flex-direction: column; gap: 32px; max-width: 880px; margin: 0 auto; padding: 28px 32px 40px; }
  .fbx-noteform.fbx-detail__body { display: grid; align-content: start; padding: 28px 32px; }
  .fbx-back { display: none; }
  .fbx-section { display: flex; flex-direction: column; gap: 14px; }
  .fbx-eyebrow { color: var(--ink-400); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }

  .fbx-pill { padding: 3px 10px; border-radius: var(--radius-pill); font-size: 12px; font-weight: 600; line-height: 1.5; white-space: nowrap; }
  .fbx-pill--new { background: var(--accent-tint); color: var(--accent-600); }
  .fbx-pill--in_progress { background: var(--info-100); color: var(--info-700); }
  .fbx-pill--warn { background: var(--warn-100); color: var(--warn-700); }
  .fbx-pill--done { background: var(--success-100); color: var(--success-700); }

  .fbx-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 7px 14px; border: 1px solid var(--divider); border-radius: var(--radius-sm); background: var(--glass-tint-high); color: var(--ink-900); font-size: 13px; font-weight: 500; white-space: nowrap; cursor: pointer; box-shadow: var(--shadow-sm); transition: background var(--dur-fast), filter var(--dur-fast), transform var(--dur-fast) var(--ease-spring); }
  .fbx-btn:hover { background: #fff; }
  .fbx-btn:active { transform: scale(0.97); }
  .fbx-btn:disabled { opacity: 0.55; cursor: progress; }
  .fbx-btn--primary { border-color: transparent; background: var(--accent-500); color: #fff; font-weight: 600; }
  .fbx-btn--primary:hover { background: var(--accent-500); filter: brightness(1.08); }
  .fbx-btn--dark { padding: 0 20px; border: 0; background: var(--ink-900); color: #fff; font-size: 15px; font-weight: 600; box-shadow: none; }
  .fbx-btn--dark:hover { background: var(--ink-900); filter: brightness(1.25); }
