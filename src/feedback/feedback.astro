---
import { execFileSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';

// When the website (code, not content) last changed: the date of the latest
// commit that touches anything outside the CMS-owned paths, so content edits
// and media uploads from the Sveltia admin (also commits on main) don't count.
// Falls back to the build time outside a git checkout.
const CMS_PATHS = [':(exclude)content', ':(exclude)public/assets'];
let lastUpdated = new Date().toISOString();
try {
  lastUpdated = execFileSync('git', ['log', '-1', '--format=%cI', '--', '.', ...CMS_PATHS], { encoding: 'utf8' }).trim() || lastUpdated;
} catch {
  // Not a git checkout: keep the build time.
}
---

<!--
  Testing page (/feedback): the real homepage (header and footer included) is
  shown inert behind a full-height dialog. The sheet is a plain
  tool UI with its own minimal light theme and deliberately does NOT follow the
  site design system (tokens.css / global.css styles), see README "Feedback tool".
-->
<Base title="Testing" description="Website feedback, changelog and developer notes for testers" noIndex>
  <div class="inbox-behind" inert aria-hidden="true"><HomeContent /></div>
  <section class="inbox fbk" role="dialog" aria-modal="true" aria-label="Testing">
    <h1 class="visually-hidden">Testing</h1>
    <header class="inbox__head">
      <nav class="views" aria-label="Sections">
        <a class="views__tab" href="#new" data-view="feedback">Feedback <span data-count="New"></span></a>
        <a class="views__tab" href="#changelog" data-view="changelog">Changelog</a>
        <a class="views__tab views__tab--notes" href="#notes" data-view="notes">Developer notes <span data-count="Notes"></span></a>
      </nav>
      <p class="inbox__updated">Website last updated <time id="last-updated" datetime={lastUpdated}>{new Date(lastUpdated).toUTCString()}</time></p>
    </header>

    <div id="feedback-view" class="view">
    <nav class="tabs" aria-label="Filter by status">
      <a class="tab" href="#new" data-filter="New">New <span data-count="New"></span></a>
      <a class="tab" href="#in-progress" data-filter="In progress">In progress <span data-count="In progress"></span></a>
      <a class="tab" href="#done" data-filter="Done">Done <span data-count="Done"></span></a>
      <a class="tab" href="#all" data-filter="All">All <span data-count="All"></span></a>
    </nav>
    <div id="entries" class="entries" aria-live="polite"><p class="empty">Loading feedback…</p></div>

    <details class="note">
      <summary>Add a note without a screenshot</summary>
      <form id="feedback-form" class="note__form">
        <label>Comment<textarea name="message" required maxlength="10000" rows="3" placeholder="Describe what you noticed…"></textarea></label>
        <label>Page <span>(optional)</span><input name="page" maxlength="500" placeholder="/tickets" /></label>
        <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Add images">
          Drop or paste images here, or <button type="button" id="pick-images">choose files</button>
          <input id="image-input" type="file" accept="image/*" multiple hidden />
        </div>
        <div class="previews" id="previews"></div>
        <div class="note__actions"><button class="fb-btn fb-btn--primary" type="submit">Add note</button><p id="form-status" role="status"></p></div>
      </form>
    </details>
    </div>

    <div id="changelog-view" class="view" hidden>
      <article id="changelog-body" class="changelog__body" aria-live="polite"><p class="empty">Loading changelog…</p></article>
    </div>

    <div id="notes-view" class="view" hidden>
      <div id="notes-list" class="entries" aria-live="polite"><p class="empty">Loading notes…</p></div>
    </div>
  </section>

  <dialog id="lightbox" class="lightbox fbk"><form method="dialog"><button aria-label="Close">×</button></form><img alt="" /></dialog>
</Base>

<style is:global>
  /* Own minimal light theme, independent of the site design system. */
  .fbk {
    --bg: #f5f6f4; --paper: #fff; --ink: #1c211b; --ink-2: #485046; --muted: #7b8478; --line: #e2e5e0; --line-2: #cdd2ca;
    --accent: #2d6a3a; --accent-soft: #e6f0e7; --tester: #b7791f; --tester-soft: #fbf3e4; --danger: #b3261e;
    color: var(--ink); font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; letter-spacing: normal; text-transform: none;
  }
  .fbk *, .fbk *::before, .fbk *::after { box-sizing: border-box; }
  .fbk a { color: var(--accent); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* The homepage behind doesn't scroll (and fills the width like on /: .main
     centres its children); the dialog is fixed, spans the full screen height
     and scrolls on its own. */
  html:has(.inbox.fbk) { overflow: hidden; }
  .inbox-behind { width: 100%; }
  .inbox { position: fixed; top: 0; bottom: 0; left: 50%; z-index: 9600; width: 100%; max-width: 920px; transform: translateX(-50%); overflow-y: auto; overscroll-behavior: contain; margin: 0; padding: 0 16px 32px; background: var(--bg); box-shadow: 0 0 40px #0006; }
  .inbox__head { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 16px; margin: 0 -16px 10px; padding: 0 16px; background: var(--bg); border-bottom: 1px solid var(--line); }
  .inbox__updated { margin: 0; padding: 8px 0; color: var(--muted); font-size: 12px; }
  .inbox__updated time { color: var(--ink-2); font-weight: 600; }
  .views { display: flex; flex-wrap: wrap; gap: 0 18px; }
  .views__tab { display: inline-flex; align-items: center; gap: 5px; margin-bottom: -1px; padding: 10px 0 8px; border-bottom: 2px solid transparent; color: var(--ink-2); font-weight: 600; text-decoration: none; }
  .fbk .views__tab { color: var(--ink-2); }
  .views__tab:hover { color: var(--ink); }
  .fbk .views__tab.is-active { border-bottom-color: var(--accent); color: var(--accent); }
  .views__tab span, .tab span { color: var(--muted); font-size: 12px; font-weight: 400; }
  .views__tab span:empty, .tab span:empty { display: none; }
  .views__tab--notes.has-unseen:not(.is-active)::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--tester); }

  .view { display: grid; gap: 8px; }
  .view[hidden] { display: none; }
  .tabs { display: flex; flex-wrap: wrap; gap: 0 14px; }
  .fbk .tab { color: var(--muted); font-size: 12px; font-weight: 600; text-decoration: none; }
  .fbk .tab:hover { color: var(--ink); }
  .fbk .tab.is-active { color: var(--accent); }
  .entries { display: grid; gap: 6px; }
  .empty { margin: 0; padding: 20px; border: 1px dashed var(--line-2); border-radius: 6px; color: var(--muted); text-align: center; }

  /* Feedback item */
  .fb-item { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 12px; padding: 10px; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; }
  .fb-item.is-new { box-shadow: inset 3px 0 0 var(--accent); }
  .fb-item__shot { display: block; height: 72px; padding: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 4px; background: var(--bg); cursor: zoom-in; }
  .fb-item__shot img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .fb-item__shot--none { display: grid; place-items: center; color: var(--muted); font-size: 11px; cursor: default; }
  .fb-item__body { display: grid; align-content: start; gap: 6px; min-width: 0; }
  .fb-item__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; color: var(--muted); font-size: 12px; }
  .fb-item__meta strong { color: var(--ink-2); font-weight: 600; }
  .fb-item__meta a { overflow-wrap: anywhere; }
  .fb-item__badge { padding: 0 6px; border-radius: 3px; background: var(--bg); color: var(--ink-2); font-size: 11px; font-weight: 600; }
  .fb-item__badge--warn { color: var(--danger); }
  .fb-item__badge--new { background: var(--accent-soft); color: var(--accent); }
  .fb-item__message { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .fb-item__more { display: flex; flex-wrap: wrap; gap: 4px; }
  .fb-item__more button { width: 48px; height: 34px; padding: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 3px; background: none; cursor: zoom-in; }
  .fb-item__more img { width: 100%; height: 100%; object-fit: cover; }
  /* Actions sit at the end of the meta line instead of on a row of their own. */
  .fb-item__body { grid-template-columns: minmax(0, 1fr) auto; }
  .fb-item__body > * { grid-column: 1 / -1; }
  .fb-item__body > .fb-item__meta { grid-column: 1; }
  .fb-item__body > .fb-item__actions { grid-column: 2; grid-row: 1; align-self: start; }
  .fb-item__actions { display: flex; align-items: center; gap: 12px; }
  .fb-item__accept, .fb-item__delete, .fb-reply__toggle { padding: 0; border: 0; background: none; font: inherit; font-size: 12px; cursor: pointer; }
  .fb-item__accept { color: var(--accent); font-weight: 600; }
  .fb-item__delete { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 4px; color: var(--muted); }
  .fb-item__delete:hover, .fb-item__delete:focus-visible { background: #b3261e14; color: var(--danger); }
  .fb-item__accept:hover, .fb-reply__toggle:hover { text-decoration: underline; }

  /* Comments and replies */
  .fb-comments { display: grid; gap: 4px; }
  .fb-comment { display: grid; gap: 2px; padding: 6px 10px; background: var(--accent-soft); border-left: 2px solid var(--accent); border-radius: 0 4px 4px 0; }
  .fb-comment--tester { background: var(--tester-soft); border-left-color: var(--tester); }
  .fb-comment__message { overflow-wrap: anywhere; }
  .fb-comment__message > * { margin: 0 0 6px; }
  .fb-comment__message > :last-child { margin-bottom: 0; }
  .fb-comment__message img { display: block; max-width: min(100%, 280px); max-height: 180px; border: 1px solid var(--line); border-radius: 3px; object-fit: contain; cursor: zoom-in; }
  .fb-reply__toggle { justify-self: start; color: var(--accent); font-weight: 600; }
  .fb-reply__toggle[hidden] { display: none; }
  .fb-reply__form { display: grid; gap: 6px; }
  .fb-reply__form[hidden] { display: none; }
  .fb-reply__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .fb-reply__status { margin: 0; color: var(--danger); font-size: 12px; }

  /* Buttons and fields */
  .fb-btn { padding: 4px 10px; border: 1px solid var(--line-2); border-radius: 4px; background: var(--paper); color: var(--ink); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  .fb-btn:hover { border-color: var(--ink-2); }
  .fb-btn:disabled { opacity: .5; cursor: progress; }
  .fb-btn--primary { border-color: var(--accent); background: var(--accent); color: #fff; }
  .fb-btn--primary:hover { border-color: var(--accent); filter: brightness(1.1); }
  .fbk textarea, .fbk input { width: 100%; padding: 6px 8px; border: 1px solid var(--line-2); border-radius: 4px; background: var(--paper); color: var(--ink); font: inherit; resize: vertical; }
  .fbk textarea:focus, .fbk input:focus { border-color: var(--accent); outline: 2px solid var(--accent-soft); }

  /* Developer notes */
  .dev-note { display: grid; gap: 4px; padding: 10px 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; }
  .dev-note__title { margin: 0; font-size: 15px; font-weight: 700; }
  .dev-note__message { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }

  /* Changelog: markdown rendered by the server (raw HTML escaped there). */
  .changelog__body { padding: 4px 2px; line-height: 1.55; overflow-wrap: anywhere; }
  .changelog__body > :first-child { margin-top: 0; }
  .changelog__body h1, .changelog__body h2 { margin: 1.4em 0 .4em; font-size: 17px; }
  .changelog__body h3, .changelog__body h4 { margin: 1.2em 0 .3em; font-size: 15px; }
  .changelog__body p, .changelog__body ul, .changelog__body ol, .changelog__body blockquote, .changelog__body table, .changelog__body pre { margin: 0 0 .8em; }
  .changelog__body ul, .changelog__body ol { padding-left: 1.3em; }
  .changelog__body code { padding: 1px 4px; border-radius: 3px; background: var(--line); font-size: .9em; }
  .changelog__body pre { padding: 8px 10px; overflow-x: auto; border-radius: 4px; background: var(--paper); border: 1px solid var(--line); }
  .changelog__body pre code { padding: 0; background: none; }
  .changelog__body blockquote { padding-left: 10px; border-left: 2px solid var(--line-2); color: var(--ink-2); }
  .changelog__body hr { margin: 1.5em 0; border: 0; border-top: 1px solid var(--line); }
  .changelog__body img { max-width: 100%; border-radius: 4px; }
  .changelog__body table { width: 100%; border-collapse: collapse; }
  .changelog__body th, .changelog__body td { padding: 4px 8px; border: 1px solid var(--line); text-align: left; }

  /* Manual note form */
  .note { margin-top: 6px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); }
  .note summary { padding: 8px 12px; color: var(--ink-2); font-size: 13px; font-weight: 600; cursor: pointer; }
  .note__form { display: grid; gap: 10px; padding: 0 12px 12px; }
  .note label { display: grid; gap: 4px; font-size: 13px; font-weight: 600; }
  .note label span { color: var(--muted); font-weight: 400; }
  .dropzone { padding: 10px; border: 1px dashed var(--line-2); border-radius: 4px; color: var(--muted); font-size: 13px; text-align: center; cursor: pointer; }
  .dropzone.is-over { border-color: var(--accent); background: var(--accent-soft); }
  .dropzone button { padding: 0; border: 0; background: none; color: var(--accent); font: inherit; text-decoration: underline; cursor: pointer; }
  .previews { display: flex; flex-wrap: wrap; gap: 6px; }
  .previews:empty { display: none; }
  .preview { position: relative; width: 64px; height: 64px; overflow: hidden; border-radius: 4px; }
  .preview img { width: 100%; height: 100%; object-fit: cover; }
  .preview button { position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 50%; background: #000a; color: #fff; font-size: 12px; cursor: pointer; }
  .note__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  #form-status { margin: 0; color: var(--accent); font-size: 13px; }

  .lightbox { max-width: min(1200px, 94vw); max-height: 92vh; padding: 0; border: 0; border-radius: 6px; background: var(--paper); box-shadow: 0 10px 40px #0005; }
  .lightbox::backdrop { background: #0009; }
  .lightbox img { display: block; max-width: 100%; max-height: 90vh; }
  .lightbox form { position: absolute; top: 6px; right: 6px; }
  .lightbox button { width: 28px; height: 28px; border: 0; border-radius: 50%; background: #000a; color: #fff; font-size: 18px; cursor: pointer; }

  @media (max-width: 640px) {
    .inbox { padding: 0 10px 24px; }
    .inbox__head { margin: 0 -10px 8px; padding: 0 10px; }
    .views { gap: 0 14px; }
    .fb-item { grid-template-columns: 72px minmax(0, 1fr); gap: 10px; padding: 8px; }
    .fb-item__shot { height: 56px; }
    .fb-item__body > .fb-item__meta { grid-column: 1 / -1; }
    .fb-item__body > .fb-item__actions { grid-column: 1 / -1; grid-row: auto; justify-self: end; }
  }
</style>

<script>
  type Entry = {
    id: string; name: string; page: string; message: string; status: string; createdAt: string;
    images: { name: string; url: string }[];
    comments?: { date: string; author?: string; message: string; html?: string }[];
    metadata?: {
      viewport?: { width: number; height: number };
      embeds?: { kind: 'youtube' | 'map' | 'iframe'; url: string; title?: string }[];
      screenshotFailed?: boolean;
    };
  };
  const API = '/__feedback/api/entries';
  // Feedback is anonymous; older entries may still carry a name, never shown.
  const PSEUDONYM = 'Jah a the Creator';
  const EMBED_LABELS: Record<string, string> = { youtube: '▶ YouTube video', map: 'map', iframe: 'embed' };
  const FILTERS: Record<string, string> = { '#new': 'New', '#in-progress': 'In progress', '#done': 'Done', '#all': 'All' };

  const list = document.querySelector<HTMLElement>('#entries')!;
  const lightbox = document.querySelector<HTMLDialogElement>('#lightbox')!;
  let entries: Entry[] = [];
  let loaded = false;

  // #notes and #changelog open those sections; any other hash is a status filter.
  const filter = () => (location.hash === '#notes' ? 'Notes' : location.hash === '#changelog' ? 'Changelog' : FILTERS[location.hash] || 'New');
  const view = (current: string) => (current === 'Notes' ? 'notes' : current === 'Changelog' ? 'changelog' : 'feedback');
  const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[c]!);
  const relative = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
  function ago(iso: string) {
    const seconds = (new Date(iso).getTime() - Date.now()) / 1000;
    for (const [unit, size] of [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]] as const) {
      if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit);
    }
    return 'just now';
  }

  function render() {
    const current = filter();
    document.querySelectorAll<HTMLAnchorElement>('[data-filter]').forEach((tab) => tab.classList.toggle('is-active', tab.dataset.filter === current));
    document.querySelectorAll<HTMLAnchorElement>('[data-view]').forEach((tab) => tab.classList.toggle('is-active', tab.dataset.view === view(current)));
    document.querySelector<HTMLElement>('#feedback-view')!.hidden = view(current) !== 'feedback';
    document.querySelector<HTMLElement>('#changelog-view')!.hidden = view(current) !== 'changelog';
    document.querySelector<HTMLElement>('#notes-view')!.hidden = view(current) !== 'notes';
    renderNotes();
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((count) => {
      const status = count.dataset.count!;
      if (status === 'Notes') { count.textContent = notesLoaded && notes.length ? String(notes.length) : ''; return; }
      const n = status === 'All' ? entries.length : entries.filter((entry) => entry.status === status).length;
      count.textContent = loaded && n ? String(n) : '';
    });
    if (!loaded) return;
    const visible = current === 'All' ? entries : entries.filter((entry) => entry.status === current);
    if (!visible.length) {
      list.innerHTML = `<p class="empty">${current === 'New' ? 'No new feedback. 🎉' : 'Nothing here.'}</p>`;
      return;
    }
    list.innerHTML = visible.map((entry) => {
      const [first, ...rest] = entry.images;
      const viewport = entry.metadata?.viewport;
      return `<article class="fb-item ${entry.status === 'New' ? 'is-new' : ''}" data-id="${entry.id}">
        ${first ? `<button class="fb-item__shot" type="button" data-zoom="${first.url}" aria-label="Enlarge screenshot"><img src="${first.url}" alt="" loading="lazy"></button>` : '<div class="fb-item__shot fb-item__shot--none">No screenshot</div>'}
        <div class="fb-item__body">
          <div class="fb-item__meta">
            <strong>${PSEUDONYM}</strong>
            <time datetime="${entry.createdAt}" title="${new Date(entry.createdAt).toLocaleString()}">${ago(entry.createdAt)}</time>
            ${entry.page ? `<a href="${escapeHtml(entry.page)}" target="_blank" rel="noreferrer">${escapeHtml(entry.page)}</a>` : ''}
            ${viewport ? `<span>${viewport.width}×${viewport.height}</span>` : ''}
            ${current === 'All' ? `<span class="fb-item__badge">${entry.status}</span>` : ''}
            ${(entry.metadata?.embeds || []).map((embed) => `<a href="${escapeHtml(embed.url)}" target="_blank" rel="noreferrer" title="${escapeHtml(embed.title || embed.url)}">${EMBED_LABELS[embed.kind] || 'embed'} on screen</a>`).join('')}
            ${entry.metadata?.screenshotFailed ? '<span class="fb-item__badge fb-item__badge--warn">screenshot failed</span>' : ''}
          </div>
          <p class="fb-item__message">${escapeHtml(entry.message)}</p>
          ${renderComments(entry)}
          ${entry.comments?.length ? renderReply(entry) : ''}
          ${rest.length ? `<div class="fb-item__more">${rest.map((image) => `<button type="button" data-zoom="${image.url}" aria-label="Enlarge image"><img src="${image.url}" alt="" loading="lazy"></button>`).join('')}</div>` : ''}
          <div class="fb-item__actions">
            ${entry.status === 'In progress' ? '<button class="fb-item__accept" type="button" data-accept title="The change works: move this to Done">✓ Accept change</button>' : ''}
            <button class="fb-item__delete" type="button" data-delete aria-label="Delete" title="Delete"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg></button>
          </div>
        </div>
      </article>`;
    }).join('');
  }

  // Reply drafts survive the 30-second refresh (which re-renders the list).
  const drafts = new Map<string, { open: boolean; text: string; status?: string }>();
  function renderReply(entry: Entry) {
    const draft = drafts.get(entry.id);
    return `<div class="fb-reply">
        <button class="fb-reply__toggle" type="button" data-reply-toggle ${draft?.open ? 'hidden' : ''}>Reply</button>
        <form class="fb-reply__form" data-reply-form ${draft?.open ? '' : 'hidden'}>
          <textarea name="message" rows="3" maxlength="5000" required placeholder="Reply to the developer…" aria-label="Reply">${escapeHtml(draft?.text || '')}</textarea>
          <div class="fb-reply__actions">
            <button class="fb-btn fb-btn--primary" type="submit">Send reply</button>
            <button class="fb-btn" type="button" data-reply-cancel>Cancel</button>
            <p class="fb-reply__status" role="status">${escapeHtml(draft?.status || '')}</p>
          </div>
        </form>
      </div>`;
  }

  // Developer comments (markdown from the feedback CMS, rendered to safe HTML by
  // the API), oldest first.
  function renderComments(entry: Entry) {
    const comments = (entry.comments || []).filter((comment) => comment && typeof comment.message === 'string' && comment.message.trim());
    if (!comments.length) return '';
    return `<div class="fb-comments">${[...comments].sort((a, b) => time(a.date) - time(b.date)).map((comment) => `<div class="fb-comment${comment.author === PSEUDONYM ? ' fb-comment--tester' : ''}">
        <div class="fb-item__meta">
          <strong>${escapeHtml(comment.author || 'Developer')}</strong>
          ${time(comment.date) ? `<time datetime="${escapeHtml(comment.date)}" title="${new Date(comment.date).toLocaleString()}">${ago(comment.date)}</time>` : ''}
        </div>
        <div class="fb-comment__message">${comment.html ?? `<p>${linkify(comment.message)}</p>`}</div>
      </div>`).join('')}</div>`;
  }

  // Bumped by every status change / delete. A refresh that started before a
  // change finished is dropped, so it can't bring back a deleted item or an
  // old status (e.g. the refresh triggered by refocusing after confirm()).
  let revision = 0;
  let renderPending = false;
  const typingReply = () => document.activeElement instanceof HTMLTextAreaElement && !!document.activeElement.closest('[data-reply-form]');
  // Background refreshes wait while a reply is being typed (re-rendering would
  // drop the focus); the focusout handler applies them afterwards.
  function renderUnlessTyping() {
    if (typingReply()) renderPending = true;
    else render();
  }
  async function load() {
    const startedAt = revision;
    try {
      const response = await fetch(API, { cache: 'no-store' });
      if (!response.ok) throw new Error();
      const fresh = (await response.json()).entries;
      if (startedAt !== revision) return;
      entries = fresh;
      loaded = true;
      renderUnlessTyping();
    } catch {
      if (!loaded) list.innerHTML = '<p class="empty">The feedback service is unavailable.</p>';
    }
  }

  async function mutate(request: () => Promise<Response>, apply: () => void, undo: () => void, failure: string) {
    revision += 1;
    apply();
    render();
    const response = await request().catch(() => undefined);
    revision += 1;
    if (!response?.ok) { undo(); render(); alert(failure); }
    void load();
  }

  list.addEventListener('click', async (event) => {
    const commentImage = (event.target as Element).closest<HTMLImageElement>('.fb-comment__message img');
    if (commentImage) {
      lightbox.querySelector('img')!.src = commentImage.src;
      lightbox.showModal();
      return;
    }
    const button = (event.target as Element).closest<HTMLButtonElement>('button');
    if (!button) return;
    if (button.dataset.zoom) {
      lightbox.querySelector('img')!.src = button.dataset.zoom;
      lightbox.showModal();
      return;
    }
    const id = button.closest<HTMLElement>('[data-id]')?.dataset.id;
    const entry = entries.find((item) => item.id === id);
    if (!id || !entry) return;
    if ('replyToggle' in button.dataset) {
      drafts.set(id, { open: true, text: drafts.get(id)?.text || '' });
      render();
      list.querySelector<HTMLTextAreaElement>(`[data-id="${id}"] [data-reply-form] textarea`)?.focus();
      return;
    }
    if ('replyCancel' in button.dataset) {
      drafts.delete(id);
      render();
      return;
    }
    if ('accept' in button.dataset) {
      if (!confirm('Accept this change? It moves to Done.')) return;
      const before = entry.status;
      await mutate(
        () => fetch(`${API}/${id}/accept`, { method: 'POST' }),
        () => { entry.status = 'Done'; },
        () => { entry.status = before; },
        'Could not accept this change.',
      );
      return;
    }
    if ('delete' in button.dataset) {
      const preview = entry.message.length > 160 ? `${entry.message.slice(0, 160)}…` : entry.message;
      if (!confirm(`Delete this feedback?\n\n“${preview}”`)) return;
      const removed = entry;
      await mutate(
        () => fetch(`${API}/${id}`, { method: 'DELETE' }),
        () => { entries = entries.filter((item) => item.id !== id); },
        () => { if (!entries.some((item) => item.id === id)) entries = [...entries, removed].sort((a, b) => b.createdAt.localeCompare(a.createdAt)); },
        'Could not delete this feedback.',
      );
    }
  });
  list.addEventListener('input', (event) => {
    const field = event.target as HTMLTextAreaElement;
    const id = field.closest<HTMLElement>('[data-id]')?.dataset.id;
    if (id && field.closest('[data-reply-form]')) drafts.set(id, { open: true, text: field.value });
  });
  list.addEventListener('focusout', () => {
    // Apply a refresh that arrived while typing, once focus has really left.
    setTimeout(() => { if (renderPending && !typingReply()) { renderPending = false; render(); } }, 0);
  });
  list.addEventListener('submit', async (event) => {
    const form = (event.target as Element).closest<HTMLFormElement>('[data-reply-form]');
    const id = form?.closest<HTMLElement>('[data-id]')?.dataset.id;
    if (!form || !id) return;
    event.preventDefault();
    const text = new FormData(form).get('message')?.toString().trim() || '';
    if (!text) return;
    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    submit.disabled = true;
    form.querySelector('.fb-reply__status')!.textContent = 'Sending…';
    revision += 1;
    try {
      const response = await fetch(`${API}/${id}/replies`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: text }) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Could not send the reply.');
      drafts.delete(id);
      entries = entries.map((item) => (item.id === id ? result.entry : item));
      (document.activeElement as HTMLElement | null)?.blur();
      render();
    } catch (error) {
      drafts.set(id, { open: true, text, status: error instanceof Error ? error.message : 'Could not send the reply.' });
      render();
    } finally {
      revision += 1;
    }
  });
  lightbox.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });


  // ---- Developer notes (written in the feedback CMS, served by the API) ----
  type Note = { title: string; date: string; author?: string; message: string; page?: string };
  const notesList = document.querySelector<HTMLElement>('#notes-list')!;
  let notes: Note[] = [];
  let notesLoaded = false;
  // Notes newer than this browser's last visit to the tab get a "New" badge.
  const SEEN_KEY = 'feedback-notes-seen';
  const readSeen = () => { try { return localStorage.getItem(SEEN_KEY) || ''; } catch { return ''; } };
  let seenBefore = readSeen();
  const time = (iso: string) => Date.parse(iso) || 0;
  const linkify = (text: string) => escapeHtml(text).replace(/https?:\/\/[^\s<]+/g, (url) => `<a href="${url}" target="_blank" rel="noreferrer">${url}</a>`);
  const safeHref = (href: string) => (/^(\/|https?:\/\/)/.test(href) ? escapeHtml(href) : '');

  function renderNotes() {
    const seen = time(seenBefore);
    document.querySelector<HTMLElement>('.views__tab--notes')!.classList.toggle('has-unseen', notes.some((note) => time(note.date) > seen));
    if (!notesLoaded) return;
    if (filter() === 'Notes' && notes[0]) {
      try { localStorage.setItem(SEEN_KEY, notes[0].date); } catch { /* private mode */ }
    }
    notesList.innerHTML = notes.length ? notes.map((note) => `<article class="dev-note">
        <h2 class="dev-note__title">${escapeHtml(note.title || '')}</h2>
        <div class="fb-item__meta">
          <strong>${escapeHtml(note.author || 'Developer')}</strong>
          <time datetime="${escapeHtml(note.date)}">${new Date(note.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
          ${note.page && safeHref(note.page) ? `<a href="${safeHref(note.page)}">${escapeHtml(note.page)}</a>` : ''}
          ${time(note.date) > seen ? '<span class="fb-item__badge fb-item__badge--new">New</span>' : ''}
        </div>
        <p class="dev-note__message">${linkify(note.message)}</p>
      </article>`).join('') : '<p class="empty">No notes from the developer yet.</p>';
  }

  async function loadNotes() {
    try {
      const response = await fetch('/__feedback/api/notes', { cache: 'no-store' });
      if (!response.ok) throw new Error();
      notes = (await response.json()).notes;
      notesLoaded = true;
      renderUnlessTyping();
    } catch {
      if (!notesLoaded) notesList.innerHTML = '<p class="empty">Notes are unavailable.</p>';
    }
  }

  // "Website last updated": the relative time ("2 hours ago"); the exact date is
  // in the tooltip.
  const updated = document.querySelector<HTMLTimeElement>('#last-updated')!;
  function renderUpdated() {
    const date = new Date(updated.dateTime);
    updated.textContent = ago(updated.dateTime);
    updated.title = date.toLocaleString();
  }
  renderUpdated();
  setInterval(renderUpdated, 60000);

  window.addEventListener('hashchange', () => { seenBefore = readSeen(); render(); });
  // ---- Changelog (markdown from the feedback CMS, rendered by the server) ----
  const changelogBody = document.querySelector<HTMLElement>('#changelog-body')!;
  let changelogLoaded = false;
  async function loadChangelog() {
    try {
      const response = await fetch('/__feedback/api/changelog', { cache: 'no-store' });
      if (!response.ok) throw new Error();
      const { html } = await response.json();
      changelogBody.innerHTML = html || '<p class="empty">Nothing in the changelog yet.</p>';
      changelogLoaded = true;
    } catch {
      if (!changelogLoaded) changelogBody.innerHTML = '<p class="empty">The changelog is unavailable right now.</p>';
    }
  }

  const refresh = () => { void load(); void loadNotes(); void loadChangelog(); };
  window.addEventListener('focus', refresh);
  setInterval(() => { if (document.visibilityState === 'visible') refresh(); }, 30000);
  render();
  refresh();

  // ---- Manual note form ----
  const form = document.querySelector<HTMLFormElement>('#feedback-form')!;
  const fileInput = document.querySelector<HTMLInputElement>('#image-input')!;
  const dropzone = document.querySelector<HTMLElement>('#dropzone')!;
  const previews = document.querySelector<HTMLElement>('#previews')!;
  const formStatus = document.querySelector<HTMLElement>('#form-status')!;
  const files: File[] = [];

  function renderPreviews() {
    previews.replaceChildren(...files.map((file, index) => {
      const item = document.createElement('div');
      item.className = 'preview';
      const image = document.createElement('img');
      image.src = URL.createObjectURL(file);
      image.alt = file.name;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.setAttribute('aria-label', `Remove ${file.name}`);
      remove.addEventListener('click', () => { files.splice(index, 1); renderPreviews(); });
      item.append(image, remove);
      return item;
    }));
  }
  function addFiles(list: FileList | null | undefined) {
    for (const file of list || []) if (file.type.startsWith('image/') && files.length < 10) files.push(file);
    renderPreviews();
  }
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); fileInput.click(); } });
  fileInput.addEventListener('change', () => addFiles(fileInput.files));
  ['dragenter', 'dragover'].forEach((name) => dropzone.addEventListener(name, (event) => { event.preventDefault(); dropzone.classList.add('is-over'); }));
  ['dragleave', 'drop'].forEach((name) => dropzone.addEventListener(name, (event) => { event.preventDefault(); dropzone.classList.remove('is-over'); }));
  dropzone.addEventListener('drop', (event) => addFiles((event as DragEvent).dataTransfer?.files));
  form.addEventListener('paste', (event) => addFiles(event.clipboardData?.files));

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    formStatus.textContent = 'Sending…';
    const data = new FormData(form);
    files.forEach((file) => data.append('images', file));
    try {
      const response = await fetch(API, { method: 'POST', body: data });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || (response.status === 413 ? 'Too large: the public site accepts about 1 MB per note. Use fewer or smaller images.' : 'Could not add the note.'));
      form.reset();
      files.splice(0);
      renderPreviews();
      formStatus.textContent = 'Added.';
      location.hash = '#new';
      await load();
    } catch (error) {
      formStatus.textContent = error instanceof Error ? error.message : 'Could not add the note.';
    }
  });
</script>
