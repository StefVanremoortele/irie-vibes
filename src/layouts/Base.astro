---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Irie Vibes Roots Festival — live Roots Reggae and Dub soundsystem culture in Kortemark, Belgium. 22, 23 & 24 July 2027.',
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.name;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={site.assets.headerBanner} />
    <meta name="theme-color" content="#101510" />
    <link rel="icon" href="/assets/greenforward-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app">
      <Header path={path} />
      <main id="main" class="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      function initExternalEmbeds() {
        document.querySelectorAll<HTMLButtonElement>('[data-load-embed]').forEach((button) => {
          if (button.dataset.initialized) return;
          button.dataset.initialized = 'true';
          button.addEventListener('click', () => {
            const box = button.closest<HTMLElement>('[data-embed]');
            if (!box) return;
            const youtubeId = box.dataset.youtube;
            const mapQuery = box.dataset.map;
            if (youtubeId) {
              box.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}" title="Festival aftermovie" loading="lazy" allowfullscreen></iframe>`;
            } else if (mapQuery) {
              const encoded = encodeURIComponent(mapQuery);
              box.innerHTML = `<iframe src="https://www.google.com/maps?q=${encoded}&output=embed" title="Festival location map" loading="lazy"></iframe><a class="embed__directions" href="https://www.google.com/maps/search/?api=1&query=${encoded}">Open directions in Google Maps</a>`;
            }
          });
        });
      }

      initExternalEmbeds();
    </script>
  </body>
</html>
