---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import { site } from '../data/site';
import { heroImages } from '../data/pages';

const aftermovieId = (() => {
  try {
    return new URL(site.aftermovie.embedUrl).pathname.split('/').filter(Boolean).pop() ?? '';
  } catch {
    return '';
  }
})();
---

<Base>
  <div class="home">
    <Hero src={heroImages.home} alt="Festival grounds at night" size="lg" />
    <div class="home__body">
      <h1 class="home__title">{site.name}</h1>
      <p class="home__dates">{site.datesLabel}</p>

      {site.showCountdown && <Countdown date={site.festivalDate} />}

      <p class="home__intro">{site.intro}</p>

      {
        site.showAftermovie && (
          <div class="aftermovie">
            <h3 class="aftermovie__title">{site.aftermovie.title}</h3>
            <div class="aftermovie__frame embed" data-embed data-youtube={aftermovieId}>
              <button type="button" class="embed__button" data-load-embed>Load aftermovie from YouTube</button>
              <p>Loading this video connects to YouTube.</p>
              <a href={`https://www.youtube.com/watch?v=${aftermovieId}`}>Watch on YouTube</a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</Base>

<style>
  .home {
    width: 100%;
  }
  .home__body {
    width: 100%;
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 44px 24px 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .home__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 44px);
    letter-spacing: 0.06em;
    color: var(--secondary);
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 10px;
  }
  .home__dates {
    font-family: var(--font-display);
    font-size: clamp(13px, 1.6vw, 17px);
    letter-spacing: 0.14em;
    color: var(--on-surface);
    text-transform: uppercase;
    margin: 0 0 28px;
  }
  .home__intro {
    color: var(--on-surface);
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.75;
    text-align: center;
    max-width: 760px;
    margin: 0 0 40px;
    text-wrap: pretty;
  }

  .aftermovie {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .aftermovie__title {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 24px);
    letter-spacing: 0.08em;
    color: var(--secondary);
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 22px;
  }
  .aftermovie__frame {
    width: 100%;
    max-width: 820px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    text-align: center;
  }
  /* Inserted by script (Base.astro) after the click: no scoped-style attribute. */
  .aftermovie__frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .embed__button {
    background: var(--card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    padding: 12px 20px;
    color: var(--on-surface-strong);
    font-family: var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 13px;
    cursor: pointer;
  }
  .embed__button:hover {
    border-color: var(--secondary);
    color: var(--secondary);
  }
  .aftermovie__frame p {
    color: var(--muted);
    font-size: 13px;
    margin: 0;
  }
  .aftermovie__frame a {
    font-size: 13px;
    text-decoration: underline;
  }
</style>
