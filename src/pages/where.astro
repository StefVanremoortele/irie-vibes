---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CopyBlocks from '../components/CopyBlocks.astro';
import { site } from '../data/site';
import { contentPages, pageImages } from '../data/pages';

const page = contentPages.where;
---

<Base title={page.title}>
  <div class="where">
    <Hero src={page.hero} alt="Route to the festival" size="md" />
    <div class="section section--page">
      <h1 class="title">{page.title}</h1>
      <div class="copy copy--center where__copy">
        <CopyBlocks blocks={page.blocks} />
      </div>

      <div class="where__grid">
        <div class="where__tile where__embed">
          <iframe src={`https://www.google.com/maps?q=${encodeURIComponent(site.location.query)}&output=embed`} title="Festival location map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <a class="embed__directions" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.location.query)}`}>Open directions in Google Maps</a>
        </div>
        {pageImages.circulatieplan && (
          <div class="where__tile">
            <img src={pageImages.circulatieplan} alt="Irie Vibes circulation plan" loading="lazy" />
          </div>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  .where__copy {
    margin-bottom: 36px;
  }
  .where__copy :global(p) {
    margin-bottom: 20px;
  }
  .where__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .where__tile {
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--card-panel);
  }
  .where__tile iframe,
  .where__tile img {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    display: block;
  }
  .where__embed {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    text-align: center;
  }
  .where__embed iframe {
    flex: 1 1 auto;
    min-height: 0;
  }
  .embed__directions {
    font-size: 13px;
    text-decoration: underline;
  }
</style>
