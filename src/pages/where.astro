---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import { heroImages, pageImages } from '../data/pages';

---

<Base title="Where">
  <div class="where">
    <Hero src={heroImages.where} alt="Route to the festival" size="md" />
    <div class="section section--page">
      <h1 class="title">Where</h1>
      <div class="copy copy--center where__copy">
        <p>
          The festival entrance is at
          <strong>{site.location.label}</strong>.
        </p>
        <p>
          <strong>Bicycles</strong> can drive up to the entrance gates and park next to the
          campingbar at the Chilling Lion stage.
        </p>
        <p>
          If you come by <strong>train</strong> to Kortemark, find the Irie Vibes shuttlebus stop
          sign just outside the station. The bus drives according to train arrival times, so it will
          probably be waiting to take you to the festival.
        </p>
        <p>
          When approaching Kortemark by <strong>car</strong>, you should notice direction signs.
          Follow these to arrive safely.
        </p>
      </div>

      <div class="where__grid">
        <div class="where__tile where__embed" data-embed data-map={site.location.query}>
          <button type="button" class="embed__button" data-load-embed>Load Google Maps</button>
          <p>Loading this map connects to Google.</p>
          <a class="embed__directions" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.location.query)}`}>Open directions in Google Maps</a>
        </div>
        <div class="where__tile">
          <img src={pageImages.circulatieplan} alt="Irie Vibes circulation plan" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .where__copy {
    margin-bottom: 36px;
  }
  .where__copy p {
    margin-bottom: 20px;
  }
  .where__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .where__tile {
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--card-panel);
  }
  .where__tile iframe,
  .where__tile img {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    display: block;
  }
  .where__embed {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    text-align: center;
  }
  .where__embed iframe {
    flex: 1 1 auto;
    min-height: 0;
  }
  .where__embed p {
    color: var(--muted);
    font-size: 13px;
    margin: 0;
  }
  .embed__button {
    background: var(--card);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    padding: 12px 20px;
    color: var(--on-surface-strong);
    font-family: var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 13px;
    cursor: pointer;
  }
  .embed__button:hover {
    border-color: var(--secondary);
    color: var(--secondary);
  }
  .embed__directions {
    font-size: 13px;
    text-decoration: underline;
  }
</style>
