---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { heroImages } from '../data/pages';
import {
  greenforward,
  initiatives,
  getEdition,
  EDITION_MIN_YEAR,
  EDITION_MAX_YEAR,
  defaultEditionText,
  editions,
  aboutSections,
  shop,
  band,
} from '../data/about';

const edition2002 = getEdition(2002);
const editionOptions = editions.length > 0 ? editions : [edition2002];
const sectionConfig = (key: string) => aboutSections.find((section) => section.key === key);
const sectionHidden = (key: string) => sectionConfig(key)?.visible === false;
---

<Base title="All about Irie Vibes">
  <div class="about">
    <Hero src={heroImages.about} alt="All about Irie Vibes" size="sm" />
    <div class="section section--mid">
      <h1 class="title">All about Irie Vibes</h1>

      <div class="accs accordions">
        <details name="about" class="acc" style={`order:${sectionConfig('greenforward')?.order ?? 0}`} hidden={sectionHidden('greenforward')}>
          <summary class="acc__head">
            <span class="acc__title">VZW Greenforward</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            {
              greenforward.map((b) =>
                b.type === 'h' ? <h4 class="acc__h">{b.text}</h4> : <p class="acc__p">{b.text}</p>,
              )
            }
          </div>
        </details>

        <details name="about" class="acc" style={`order:${sectionConfig('initiatives')?.order ?? 1}`} hidden={sectionHidden('initiatives')}>
          <summary class="acc__head">
            <span class="acc__title">Socio-environmental initiatives &amp; partnerships</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            {
              initiatives.map((b) =>
                b.type === 'h' ? <h4 class="acc__h">{b.text}</h4> : <p class="acc__p">{b.text}</p>,
              )
            }
          </div>
        </details>

        <details name="about" class="acc" style={`order:${sectionConfig('editions')?.order ?? 2}`} hidden={sectionHidden('editions')}>
          <summary class="acc__head">
            <span class="acc__title">Previous editions</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            <div class="years" data-years data-archive data-min={EDITION_MIN_YEAR} data-max={EDITION_MAX_YEAR}>
              <p class="years__hint">Browse available editions. Use the five-year controls to move through the archive.</p>
              <div class="years__nav">
                <button type="button" class="years__btn years__btn--step" data-year-step="-5">-5y</button>
                <button type="button" class="years__btn" data-year-step="-1" aria-label="Previous year">‹</button>
                <label class="years__select-label" for="edition-year">Edition</label>
                <select id="edition-year" class="years__select" data-year>
                  {editionOptions.map((edition) => <option value={edition.year}>{edition.year}</option>)}
                </select>
                <button type="button" class="years__btn" data-year-step="1" aria-label="Next year">›</button>
                <button type="button" class="years__btn years__btn--step" data-year-step="5">+5y</button>
              </div>
              <div class="years__content">
                <div class="years__paras" data-year-paras>
                  {edition2002.paragraphs.map((p) => <p class="acc__p">{p}</p>)}
                </div>
                <div class="years__media">
                  <img class="years__poster" data-year-poster src={edition2002.poster} alt="Festival poster" />
                  <iframe class="years__video" data-year-video title="Previous edition video" src={undefined} hidden></iframe>
                </div>
              </div>
            </div>
          </div>
        </details>

        <details name="about" class="acc" style={`order:${sectionConfig('shop')?.order ?? 3}`} hidden={sectionHidden('shop')}>
          <summary class="acc__head">
            <span class="acc__title">Irie shop</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            <p class="acc__p acc__p--intro">{shop.intro}</p>
            <div class="shop">
              {
                shop.items.map((item) => (
                  <div class="shop__item">
                    {item.image && <img class="shop__image" src={item.image} alt={item.name} />}
                    <div class="shop__name">{item.name}</div>
                    <div class="shop__desc">{item.description}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </details>

        <details name="about" class="acc" style={`order:${sectionConfig('band')?.order ?? 4}`} hidden={sectionHidden('band')}>
          <summary class="acc__head">
            <span class="acc__title">The Irie Vibes band</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            <p class="acc__p">{band.text}</p>
          </div>
        </details>
      </div>
    </div>
  </div>
</Base>

<style>
  .about {
    width: 100%;
  }
  .accs {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .acc {
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    scroll-margin-top: var(--header-h);
  }
  .acc[hidden] {
    display: none;
  }
  .acc__head {
    list-style: none;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
  }
  .acc__head::-webkit-details-marker {
    display: none;
  }
  .acc__title {
    font-family: var(--font-display);
    font-size: clamp(14px, 1.8vw, 18px);
    letter-spacing: 0.06em;
    color: #ffffff;
    text-transform: uppercase;
  }
  .acc__chev {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--surface-container-high);
    color: var(--on-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    transition: transform 0.2s ease;
  }
  .acc[open] .acc__chev {
    transform: rotate(180deg);
  }
  .acc__panel {
    padding: 0 24px 26px;
  }
  .acc__h {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--secondary);
    text-transform: uppercase;
    margin: 22px 0 10px;
  }
  .acc__p {
    color: var(--on-surface);
    font-size: 15px;
    line-height: 1.75;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  .acc__p:last-child {
    margin-bottom: 0;
  }
  .acc__p--intro {
    margin-bottom: 20px;
  }

  /* Year navigator ---------------------------------------------------------- */
  .years__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 6px 0 22px;
  }
  .years__hint {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
    text-align: center;
    margin: 0 0 16px;
  }
  .years__btn {
    background: var(--surface-container-high);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--on-surface);
    padding: 8px 14px;
    font-size: 14px;
    cursor: pointer;
  }
  .years__btn--step {
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
  }
  .years__btn:hover {
    border-color: var(--secondary);
  }
  .years__select-label {
    color: var(--secondary);
    font-size: 13px;
    font-weight: 700;
  }
  .years__select {
    min-height: 38px;
    padding: 7px 30px 7px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-container-high);
    color: var(--on-surface);
    font: inherit;
  }
  .years__value {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--secondary);
    min-width: 92px;
    text-align: center;
  }
  .years__content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    align-items: start;
  }
  .years__poster {
    width: 100%;
    border-radius: var(--radius-lg);
    display: block;
    border: 1px solid var(--border-hairline);
  }
  .years__media {
    display: grid;
    gap: 16px;
  }
  .years__video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius-lg);
  }
  .years__poster[hidden] {
    display: none;
  }
  .years__video[hidden] {
    display: none;
  }
  .shop__image {
    width: min(100%, 220px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 10px;
  }
</style>

<script>
  function initAboutAccordions() {
    const panels = [...document.querySelectorAll<HTMLDetailsElement>('.accordions details')];
    if (!panels.length) return;
    panels.forEach((panel) => {
      panel.addEventListener('toggle', () => {
        if (!panel.open) return;
        panels.forEach((other) => {
          if (other !== panel) other.open = false;
        });
        requestAnimationFrame(() => {
          if (!panel.open) return;
          const summary = panel.querySelector<HTMLElement>('summary');
          summary?.focus({ preventScroll: true });
          panel.scrollIntoView({ block: 'start', behavior: 'instant' });
        });
      });
    });
  }

  initAboutAccordions();
</script>

<script define:vars={{ editionsData: editionOptions, defaultEditionText }}>
  function initYears() {
    const root = document.querySelector('[data-years]');
    if (!root) return;
    /** @type {HTMLSelectElement | null} */
    const selectEl = root.querySelector('[data-year]');
    const parasEl = root.querySelector('[data-year-paras]');
    const posterEl = root.querySelector('[data-year-poster]');
    const videoEl = root.querySelector('[data-year-video]');
    if (!selectEl || !parasEl || !posterEl || !videoEl) return;
    let index = 0;

    const render = () => {
      const edition = editionsData[index];
      selectEl.value = String(edition?.year ?? '');
      root.querySelectorAll('[data-year-step]').forEach((button) => {
        const step = Number(button.dataset.yearStep);
        button.toggleAttribute('disabled', (index === 0 && step < 0) || (index === editionsData.length - 1 && step > 0));
      });
      const paras = edition?.paragraphs ?? [defaultEditionText];
      parasEl.replaceChildren(
        ...paras.map((text) => {
          const p = document.createElement('p');
          p.className = 'acc__p';
          p.textContent = text;
          return p;
        }),
      );
      if (edition?.poster) {
        posterEl.src = edition.poster;
        posterEl.hidden = false;
      } else {
        posterEl.hidden = true;
      }
      if (edition?.video) {
        const url = new URL(edition.video);
        const videoId = url.searchParams.get('v') || url.pathname.split('/').pop();
        videoEl.src = videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : '';
        videoEl.hidden = !videoId;
      } else {
        videoEl.removeAttribute('src');
        videoEl.hidden = true;
      }
    };

    root.querySelectorAll('[data-year-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = Number(btn.dataset.yearStep);
        index = Math.min(editionsData.length - 1, Math.max(0, index + (step < 0 ? -1 : 1) * Math.min(Math.abs(step), 1)));
        render();
      });
    });
    selectEl.addEventListener('change', () => {
      index = Math.max(0, editionsData.findIndex((item) => String(item.year) === selectEl.value));
        render();
    });

    render();
  }

  initYears();
</script>
