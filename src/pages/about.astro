---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { heroImages } from '../data/pages';
import {
  greenforward,
  initiatives,
  getEdition,
  EDITION_MIN_YEAR,
  EDITION_MAX_YEAR,
  defaultEditionText,
  editions,
  aboutSections,
  shop,
  band,
} from '../data/about';

const editionOptions = editions.length > 0 ? editions : [getEdition(2002)];
// Open on the most recent edition that already took place (future years stay reachable via ›).
const thisYear = new Date().getFullYear();
const pastIndexes = editionOptions.flatMap((edition, i) => (edition.year <= thisYear ? [i] : []));
const startIndex = pastIndexes.length ? pastIndexes[pastIndexes.length - 1] : editionOptions.length - 1;
const startEdition = editionOptions[startIndex];
---

<Base title="All about Irie Vibes">
  <div class="about">
    <Hero src={heroImages.about} alt="All about Irie Vibes" size="sm" />
    <div class="section section--mid">
      <h1 class="title">All about Irie Vibes</h1>

      <div class="accs accordions">
        <details name="about" class="acc" style={`order:${aboutSections.greenforward.order}`} hidden={!aboutSections.greenforward.visible}>
          <summary class="acc__head">
            <span class="acc__title">{aboutSections.greenforward.title}</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            {
              greenforward.map((b) =>
                b.type === 'h' ? <h4 class="acc__h">{b.text}</h4> : <p class="acc__p">{b.text}</p>,
              )
            }
          </div>
        </details>

        <details name="about" class="acc" style={`order:${aboutSections.initiatives.order}`} hidden={!aboutSections.initiatives.visible}>
          <summary class="acc__head">
            <span class="acc__title">{aboutSections.initiatives.title}</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            {
              initiatives.map((b) =>
                b.type === 'h' ? <h4 class="acc__h">{b.text}</h4> : <p class="acc__p">{b.text}</p>,
              )
            }
          </div>
        </details>

        <details name="about" class="acc" style={`order:${aboutSections.editions.order}`} hidden={!aboutSections.editions.visible}>
          <summary class="acc__head">
            <span class="acc__title">{aboutSections.editions.title}</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            <div class="years" data-years data-archive data-min={EDITION_MIN_YEAR} data-max={EDITION_MAX_YEAR}>
              <div class="years__nav">
                <button type="button" class="years__btn" data-year-step="-1" aria-label="Previous year">‹</button>
                <select id="edition-year" class="years__select" data-year aria-label="Edition year">
                  {[...editionOptions].reverse().map((edition) => <option value={edition.year} selected={edition === startEdition}>{edition.year}</option>)}
                </select>
                <button type="button" class="years__btn" data-year-step="1" aria-label="Next year">›</button>
              </div>
              <div class="years__content">
                <div class="years__paras" data-year-paras>
                  {startEdition.paragraphs.map((p) => <p class="acc__p">{p}</p>)}
                </div>
                <div class="years__media">
                  <img class="years__poster" data-year-poster src={startEdition.poster} alt="Festival poster" hidden={!startEdition.poster} />
                  <iframe class="years__video" data-year-video title="Previous edition video" src={undefined} hidden allowfullscreen></iframe>
                  <img class="years__photo" data-year-photo src={undefined} alt="Festival crew group photo" hidden />
                </div>
              </div>
            </div>
          </div>
        </details>

        <details name="about" class="acc" style={`order:${aboutSections.shop.order}`} hidden={!aboutSections.shop.visible}>
          <summary class="acc__head">
            <span class="acc__title">{aboutSections.shop.title}</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            <p class="acc__p acc__p--intro">{shop.intro}</p>
            <div class="shop">
              {
                shop.items.map((item) => (
                  <div class="shop__item">
                    <h3 class="shop__name">{item.name}</h3>
                    {item.image && <img class="shop__image" src={item.image} alt={item.name} />}
                    <div class="shop__desc">{item.description}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </details>

        <details name="about" class="acc" style={`order:${aboutSections.band.order}`} hidden={!aboutSections.band.visible}>
          <summary class="acc__head">
            <span class="acc__title">{aboutSections.band.title}</span>
            <span class="acc__chev" aria-hidden="true">▾</span>
          </summary>
          <div class="acc__panel">
            <div class={band.media.length ? 'band band--media' : 'band'}>
              <p class="acc__p">{band.text}</p>
              {
                band.media.length > 0 && (
                  <div class="band__media">
                    {band.media.map((item) =>
                      item.video ? (
                        <iframe class="band__video" src={item.video} title={item.alt} loading="lazy" allowfullscreen />
                      ) : (
                        <img class="band__photo" src={item.image} alt={item.alt} loading="lazy" />
                      ),
                    )}
                  </div>
                )
              }
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</Base>

<style>
  .about {
    width: 100%;
  }
  .accs {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .acc {
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    scroll-margin-top: var(--header-h);
  }
  .acc[hidden] {
    display: none;
  }
  .acc__head {
    list-style: none;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
  }
  .acc__head::-webkit-details-marker {
    display: none;
  }
  .acc__title {
    font-family: var(--font-display);
    font-size: clamp(14px, 1.8vw, 18px);
    letter-spacing: 0.06em;
    color: #ffffff;
    text-transform: uppercase;
  }
  .acc__chev {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--surface-container-high);
    color: var(--on-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    transition: transform 0.2s ease;
  }
  .acc[open] .acc__chev {
    transform: rotate(180deg);
  }
  .acc__panel {
    padding: 0 24px 26px;
  }
  .acc__h {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--secondary);
    text-transform: uppercase;
    margin: 22px 0 10px;
  }
  .acc__p {
    color: var(--on-surface);
    font-size: 15px;
    line-height: 1.75;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  .acc__p:last-child {
    margin-bottom: 0;
  }
  .acc__p--intro {
    margin-bottom: 20px;
  }

  /* Year navigator ---------------------------------------------------------- */
  .years__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 18px 0 22px;
  }
  .years__btn {
    background: var(--surface-container-high);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--on-surface);
    padding: 8px 14px;
    font-size: 14px;
    cursor: pointer;
  }
  .years__btn:hover {
    border-color: var(--secondary);
  }
  .years__select {
    min-height: 38px;
    padding: 7px 30px 7px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-container-high);
    color: var(--on-surface);
    font: inherit;
  }
  .years__value {
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--secondary);
    min-width: 92px;
    text-align: center;
  }
  .years__content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    align-items: start;
  }
  .years__poster {
    width: 100%;
    border-radius: var(--radius-lg);
    display: block;
    border: 1px solid var(--border-hairline);
  }
  .years__media {
    display: grid;
    gap: 16px;
  }
  .years__video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius-lg);
  }
  .years__poster[hidden] {
    display: none;
  }
  .years__video[hidden] {
    display: none;
  }
  .years__photo {
    width: 100%;
    border-radius: var(--radius-lg);
    display: block;
    border: 1px solid var(--border-hairline);
  }
  .years__photo[hidden] {
    display: none;
  }
  .band {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .band--media {
      grid-template-columns: 1fr minmax(0, 1fr);
      align-items: start;
    }
  }
  .band__media {
    display: grid;
    gap: 16px;
  }
  .band__photo,
  .band__video {
    width: 100%;
    display: block;
    border: 0;
    border-radius: var(--radius-lg);
  }
  .band__video {
    aspect-ratio: 16 / 9;
  }
  .shop {
    display: grid;
    gap: 28px;
  }
  .shop__item {
    display: grid;
    grid-template-areas: 'name' 'image' 'desc';
    gap: 10px;
  }
  .shop__name {
    grid-area: name;
    margin: 0;
    font-size: clamp(16px, 2vw, 19px);
    font-weight: 700;
    color: var(--secondary);
  }
  .shop__image {
    grid-area: image;
    width: min(100%, 220px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .shop__desc {
    grid-area: desc;
  }
  @media (min-width: 640px) {
    .shop__item {
      grid-template-areas: 'name name' 'desc image';
      grid-template-columns: minmax(0, 1fr) 220px;
      column-gap: 24px;
      align-items: start;
    }
    .shop__image {
      justify-self: end;
    }
  }
</style>

<script>
  function initAboutAccordions() {
    const panels = [...document.querySelectorAll<HTMLDetailsElement>('.accordions details')];
    if (!panels.length) return;
    panels.forEach((panel) => {
      panel.addEventListener('toggle', () => {
        if (!panel.open) return;
        panels.forEach((other) => {
          if (other !== panel) other.open = false;
        });
        requestAnimationFrame(() => {
          if (!panel.open) return;
          const summary = panel.querySelector<HTMLElement>('summary');
          summary?.focus({ preventScroll: true });
          panel.scrollIntoView({ block: 'start', behavior: 'instant' });
        });
      });
    });
  }

  initAboutAccordions();
</script>

<script define:vars={{ editionsData: editionOptions, defaultEditionText, startIndex }}>
  function initYears() {
    const root = document.querySelector('[data-years]');
    if (!root) return;
    /** @type {HTMLSelectElement | null} */
    const selectEl = root.querySelector('[data-year]');
    const parasEl = root.querySelector('[data-year-paras]');
    const posterEl = root.querySelector('[data-year-poster]');
    const videoEl = root.querySelector('[data-year-video]');
    const photoEl = root.querySelector('[data-year-photo]');
    if (!selectEl || !parasEl || !posterEl || !videoEl || !photoEl) return;
    let index = startIndex;
    // A poster or photo that fails to load (e.g. a broken external link) is hidden, not shown broken.
    [posterEl, photoEl].forEach((img) => img.addEventListener('error', () => { img.hidden = true; }));

    const render = () => {
      const edition = editionsData[index];
      selectEl.value = String(edition?.year ?? '');
      root.querySelectorAll('[data-year-step]').forEach((button) => {
        const step = Number(button.dataset.yearStep);
        button.toggleAttribute('disabled', (index === 0 && step < 0) || (index === editionsData.length - 1 && step > 0));
      });
      const paras = edition?.paragraphs ?? [defaultEditionText];
      parasEl.replaceChildren(
        ...paras.map((text) => {
          const p = document.createElement('p');
          p.className = 'acc__p';
          p.textContent = text;
          return p;
        }),
      );
      if (edition?.poster) {
        posterEl.src = edition.poster;
        posterEl.hidden = false;
      } else {
        posterEl.hidden = true;
      }
      if (edition?.video) {
        videoEl.src = edition.video;
        videoEl.hidden = false;
      } else {
        videoEl.removeAttribute('src');
        videoEl.hidden = true;
      }
      if (edition?.photo) {
        photoEl.src = edition.photo;
        photoEl.hidden = false;
      } else {
        photoEl.removeAttribute('src');
        photoEl.hidden = true;
      }
    };

    root.querySelectorAll('[data-year-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = Number(btn.dataset.yearStep);
        index = Math.min(editionsData.length - 1, Math.max(0, index + (step < 0 ? -1 : 1) * Math.min(Math.abs(step), 1)));
        render();
      });
    });
    selectEl.addEventListener('change', () => {
      index = Math.max(0, editionsData.findIndex((item) => String(item.year) === selectEl.value));
        render();
    });

    render();
  }

  initYears();
</script>
