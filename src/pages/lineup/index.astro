---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { heroImages } from '../../data/pages';
import { stages, days, actsForStage, useCustomHtml, customHtml } from '../../data/lineup';
---

<Base title="Line up">
  <div class="lineup">
    {!useCustomHtml && <Hero src={heroImages.lineup} alt="Lions Den stage lights" size="md" />}
    <div class="section section--lineup">
      {!useCustomHtml && <h1 class="title">Line up</h1>}

      {useCustomHtml ? <div class="copy custom-html" set:html={customHtml} /> : <>
      <div class="schedule" aria-label="Festival timetable">
      <div class="stagebar stage-labels iv-desk">
        {
          stages.map((stage) => (
            <div class="stagebar__col">
              <div class="stagebar__name" style={`color:${stage.color};`}>
                {stage.name}
              </div>
              <div class="stagebar__sub">{stage.sub}</div>
            </div>
          ))
        }
      </div>

      {
        days.map((day) => (
          <section class="day festival-day">
            <div class="day__head day-heading">
              <div class="day__name">{day.name}</div>
              {day.sub && <div class="day__sub">{day.sub}</div>}
            </div>
            <div class="day__grid stage-grid">
              {stages.map((stage) => (
                <div class="day__col stage">
                  <div class="day__stagelabel stage-heading iv-mob" style={`color:${stage.color};`}>
                    {stage.name}
                    <span class="stage__sub">{stage.sub}</span>
                  </div>
                  <div class="act-list">
                    {
                      actsForStage(day, stage.key).length > 0 ? actsForStage(day, stage.key).map((act) => (
                        <a class="act performance" href={`/lineup/${act.slug}`}>
                          <div class="act__name">{act.name}</div>
                          <div class="act__time">{act.time}</div>
                        </a>
                      )) : <p class="muted">No performances announced.</p>
                    }
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
      </div>
      </>}
    </div>
  </div>
</Base>

<style>
  .lineup {
    width: 100%;
  }
  .stagebar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--surface);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: 8px;
    --stage-label-height: 0px;
  }
  .stagebar__col {
    text-align: center;
  }
  .stagebar__name {
    font-family: var(--font-display);
    font-size: clamp(14px, 1.5vw, 19px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .stagebar__sub {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--muted);
    text-transform: uppercase;
    margin-top: 4px;
    font-weight: 600;
  }

  .day {
    padding: 28px 0 8px;
    --day-heading-height: 0px;
  }
  .day__head {
    position: sticky;
    top: calc(var(--header-h) + var(--stage-label-height));
    z-index: 15;
    background: var(--surface);
    padding: 10px 0 12px;
    text-align: center;
    margin-bottom: 12px;
  }
  .day__name {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.6vw, 26px);
    letter-spacing: 0.1em;
    color: #ffffff;
    text-transform: uppercase;
  }
  .day__sub {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--muted);
    text-transform: uppercase;
    margin-top: 5px;
    font-weight: 700;
  }
  .day__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }
  .day__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .day__stagelabel {
    text-align: center;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: none;
  }
  .stage__sub {
    display: block;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.16em;
    margin-top: 4px;
    font-weight: 600;
  }
  .act-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .muted {
    color: var(--muted);
    font-size: 12px;
    text-align: center;
  }

  .act {
    display: block;
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 12px 14px;
    text-align: center;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .act:hover {
    background: #222a22;
    border-color: rgba(250, 188, 77, 0.45);
  }
  .act__name {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.01em;
  }
  .act__time {
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .stagebar {
      display: none;
    }
    .day__head {
      top: var(--header-h);
    }
    .day__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .day__stagelabel {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + var(--day-heading-height));
      z-index: 10;
      background: var(--surface);
      padding: 10px 0;
      margin-bottom: 0;
      border-bottom: 1px solid var(--border-soft);
    }
    .day__col {
      gap: 0;
    }
  }
</style>

<script>
  function initLineupMeasurements() {
    const schedule = document.querySelector<HTMLElement>('.schedule');
    if (!schedule) return;
    const stageLabels = schedule.querySelector<HTMLElement>('.stage-labels');
    const update = () => {
      if (stageLabels) {
        schedule.style.setProperty('--stage-label-height', `${stageLabels.getBoundingClientRect().height}px`);
      }
      schedule.querySelectorAll<HTMLElement>('.festival-day').forEach((day) => {
        const heading = day.querySelector<HTMLElement>('.day-heading');
        if (heading) day.style.setProperty('--day-heading-height', `${heading.getBoundingClientRect().height}px`);
      });
    };
    update();
    document.fonts?.ready.then(update);
    const observer = new ResizeObserver(update);
    if (stageLabels) observer.observe(stageLabels);
    schedule.querySelectorAll('.day-heading').forEach((heading) => observer.observe(heading));
  }

  initLineupMeasurements();
</script>
