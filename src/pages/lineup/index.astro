---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { heroImages } from '../../data/pages';
import { stages, days, actsForStage } from '../../data/lineup';
---

<Base title="Line up">
  <div class="lineup">
    <Hero src={heroImages.lineup} alt="Lions Den stage lights" size="md" />
    <div class="section section--lineup">
      <h1 class="title">Line up</h1>

      <div class="stagebar iv-desk">
        {
          stages.map((stage) => (
            <div class="stagebar__col">
              <div class="stagebar__name" style={`color:${stage.color};`}>
                {stage.name}
              </div>
              <div class="stagebar__sub">{stage.sub}</div>
            </div>
          ))
        }
      </div>

      {
        days.map((day) => (
          <section class="day">
            <div class="day__head">
              <div class="day__name">{day.name}</div>
              {day.sub && <div class="day__sub">{day.sub}</div>}
            </div>
            <div class="day__grid">
              {stages.map((stage) => (
                <div class="day__col">
                  <div class="day__stagelabel iv-mob" style={`color:${stage.color};`}>
                    {stage.name}
                  </div>
                  {actsForStage(day, stage.key).map((act) => (
                    <a class="act" href={`/lineup/${act.slug}`}>
                      <div class="act__name">{act.name}</div>
                      <div class="act__time">{act.time}</div>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .lineup {
    width: 100%;
  }
  .stagebar {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: var(--surface);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: 8px;
  }
  .stagebar__col {
    text-align: center;
  }
  .stagebar__name {
    font-family: var(--font-display);
    font-size: clamp(14px, 1.5vw, 19px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .stagebar__sub {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--muted);
    text-transform: uppercase;
    margin-top: 4px;
    font-weight: 600;
  }

  .day {
    padding: 28px 0 8px;
  }
  .day__head {
    position: sticky;
    top: calc(var(--header-h) + 64px);
    z-index: 15;
    background: var(--surface);
    padding: 10px 0 12px;
    text-align: center;
    margin-bottom: 12px;
  }
  .day__name {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.6vw, 26px);
    letter-spacing: 0.1em;
    color: #ffffff;
    text-transform: uppercase;
  }
  .day__sub {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--muted);
    text-transform: uppercase;
    margin-top: 5px;
    font-weight: 700;
  }
  .day__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    align-items: start;
  }
  .day__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .day__stagelabel {
    text-align: center;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .act {
    display: block;
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: 12px 14px;
    text-align: center;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .act:hover {
    background: #222a22;
    border-color: rgba(250, 188, 77, 0.45);
  }
  .act__name {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.01em;
  }
  .act__time {
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
    font-weight: 600;
  }
</style>
