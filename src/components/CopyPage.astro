---
import Hero from './Hero.astro';
import type { ContentPage } from '../data/types';

interface Props {
  page: ContentPage;
  width?: 'narrow' | 'mid';
}
const { page, width = 'narrow' } = Astro.props;
---

<div class="content-page">
  <Hero src={page.hero} alt={page.title} size={page.heroSize ?? 'md'} />
  <div class={`section section--${width}`}>
    <h1 class="title">{page.title}</h1>
    <div class="copy copy--center">
      {
        page.blocks.map((b) =>
          b.type === 'h' ? <h2 class="copy__h" set:html={b.html} /> : <p set:html={b.html} />,
        )
      }
    </div>
  </div>
</div>

<style>
  .content-page {
    width: 100%;
  }
  .copy__h {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 24px);
    letter-spacing: 0.08em;
    color: var(--secondary);
    text-transform: uppercase;
    margin: 28px 0 12px;
  }
</style>
