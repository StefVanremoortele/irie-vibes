---
import Hero from './Hero.astro';
import CopyBlocks from './CopyBlocks.astro';
import type { ContentPage } from '../data/types';

interface Props {
  page: ContentPage;
  width?: 'narrow' | 'mid';
}
const { page, width = 'narrow' } = Astro.props;
---

<div class="content-page">
  <Hero src={page.hero} alt={page.title} size={page.heroSize ?? 'md'} />
  <div class={`section section--${width}`}>
    <h1 class="title">{page.title}</h1>
    <div class="copy copy--center">
      <CopyBlocks blocks={page.blocks} />
    </div>
  </div>
</div>

<style>
  .content-page {
    width: 100%;
  }
</style>
