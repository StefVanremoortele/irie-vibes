---
import { site, nav } from '../data/site';
import { COLORS, GROOVES, LABEL_R, VIEWBOX, recordFrame } from '../lib/record-burger';

interface Props {
  path: string;
}
const { path } = Astro.props;

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '';
  return path === href || path.startsWith(href + '/');
}

// First frame of the record animation: the resting hamburger.
const rec = recordFrame(0);

function canonicalHref(href: string): string {
  if (href.startsWith('/') && href !== '/' && !href.endsWith('/')) return `${href}/`;
  return href;
}
---

<header class="hdr site-header">
  <div class="hdr__inner">
    <div class="hdr__bannerwrap">
      <img class="hdr__banner" src={site.assets.headerBanner} alt={site.name} />
    </div>
    <div class="hdr__bar">
      <div class="hdr__menu" data-menu>
        <button type="button" class:list={['burger', { 'burger--image': site.assets.menuButton }]} aria-label="Open navigation" aria-expanded="false" aria-controls="menu" data-menu-toggle>
          {site.assets.menuButton ? (
            <img class="burger__img" src={site.assets.menuButton} alt="" />
          ) : (
          <svg class="burger__record" viewBox={VIEWBOX} aria-hidden="true" focusable="false" data-record data-animate={site.menuAnimation ? 'true' : 'false'}>
            <defs>
              <clipPath id="record-label"><circle r={rec.clipR} data-r="clip" /></clipPath>
              <filter id="record-soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="14" /></filter>
            </defs>
            <ellipse cx="0" cy={rec.R * 0.12 + 14} rx={rec.R * 0.98} ry={rec.R * 0.96} fill="#000" opacity="0.3" filter="url(#record-soft)" data-r="shadow" />
            <circle r={rec.R} fill="#121212" data-r="disc" />
            <g data-r="spin">
              <g opacity={rec.m} data-r="grooves">
                {GROOVES.map((r, i) => (
                  <circle r={r * (rec.R / 215)} data-groove={r} fill="none" stroke={i % 7 === 3 ? 'rgba(255,255,255,0.03)' : 'rgba(255,255,255,0.075)'} stroke-width={i % 7 === 3 ? 3 : 0.8} />
                ))}
              </g>
              <g clip-path="url(#record-label)">
                {rec.bars.map((bar, i) => <rect {...bar} fill={COLORS[i]} data-r="bar" />)}
              </g>
              <g opacity={rec.labelOpacity} data-r="label">
                <circle r={LABEL_R} fill="none" stroke="rgba(0,0,0,0.25)" stroke-width="2" />
                <text y={-LABEL_R * 0.52} text-anchor="middle" font-family="Fraunces, Georgia, serif" font-size="15" fill="#1a1b26" letter-spacing="1">side a</text>
                <circle r="7" fill="#d9a62a" />
                <circle r="7" fill="none" stroke="rgba(0,0,0,0.35)" stroke-width="1.5" />
              </g>
            </g>
            <g opacity={rec.m * 0.9} data-r="reflection">
              <path d={rec.reflection[0]} fill="rgba(255,255,255,0.07)" />
              <path d={rec.reflection[1]} fill="rgba(255,255,255,0.05)" />
            </g>
            <circle r={rec.R - 0.5} fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1" data-r="rim" />
            <g opacity={rec.armOpacity} transform={`translate(232 -222) rotate(${rec.arm})`} data-r="arm">
              <circle r="22" fill="#2b2b2e" />
              <circle r="10" fill="#8a8a90" />
              <path d="M0 0 L-38 210 L-92 262" fill="none" stroke="#c8c8cc" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
              <rect x="-112" y="252" width="34" height="20" rx="4" transform="rotate(-42 -92 262)" fill="#2b2b2e" />
            </g>
          </svg>
          )}
        </button>
        <nav id="menu" class="drawer" aria-label="Main navigation" data-menu-drawer hidden>
          <ul class="drawer__list">
            {
              nav.map((n) => (
                <li>
                  <a
                    class:list={{ 'drawer__item': true, 'drawer__item--active': isActive(n.href) }}
                    href={canonicalHref(n.href)}
                    aria-current={isActive(n.href) ? 'page' : undefined}
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      {site.assets.ticketButton ? (
        <a class="ticket-btn ticket-btn--image" href={site.ticketUrl} target="_blank" rel="noopener noreferrer">
          <img class="ticket-btn__img" src={site.assets.ticketButton} alt="Get your ticket" />
        </a>
      ) : (
        <a class="ticket-btn" href={site.ticketUrl} target="_blank" rel="noopener noreferrer">
          <span class="ticket-btn__top">
            <span class="ticket-btn__get">GET</span>
            <span class="ticket-btn__your">YOUR</span>
          </span>
          <span class="ticket-btn__main">TICKET</span>
        </a>
      )}
    </div>
  </div>
</header>

<div class="hdr__overlay" data-menu-overlay hidden></div>
<div class="hdr__spacer"></div>

<style>
  .hdr {
    /* Ticket button size, capped just under the header height so it never sticks out (phones). */
    --hdr-ticket-size: min(clamp(84px, 14.25vw, 144px), calc(var(--header-h) - 4px));
    /* The menu (record) button matches the ticket button. */
    --hdr-btn-size: var(--hdr-ticket-size);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9000;
    background: var(--surface);
    box-shadow: var(--shadow-header);
  }
  .hdr__inner {
    position: relative;
    line-height: 0;
    height: var(--header-h);
  }
  .hdr__bannerwrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hdr__banner {
    width: 100%;
    height: 100%;
    /* Header box matches the banner's 6.4:1 aspect ratio (see --header-h), so
       cover fills it full-width with no crop. */
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .hdr__bar {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(12px, 3vw, 40px);
  }
  .hdr__menu {
    position: relative;
  }
  .hdr__spacer {
    height: var(--header-h);
    flex: none;
  }
  .hdr__overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
  }

  /* Hamburger --------------------------------------------------------------- */
  .burger {
    --burger-size: var(--hdr-btn-size);
    position: relative;
    width: var(--burger-size);
    height: var(--burger-size);
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
    padding: 0;
  }
  /* The record's disc (r=180 in a 600-unit viewBox) is the button itself; the
     SVG overflows the button so the bigger record and tonearm fit. */
  .burger__record {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--burger-size) * 600 / 360);
    height: calc(var(--burger-size) * 600 / 360);
    transform: translate(-50%, -50%);
    overflow: visible;
    pointer-events: none;
  }
  /* CMS image instead of the record: the image fills the round button. */
  .burger--image {
    overflow: hidden;
  }
  .burger__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .burger:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 3px;
  }

  /* Drawer ------------------------------------------------------------------ */
  .drawer {
    position: absolute;
    left: 0;
    top: calc(100% + 12px);
    width: min(288px, 78vw);
    background: var(--card-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-modal);
    padding: 12px 8px;
    z-index: 60;
    max-height: calc(100dvh - var(--header-h) - 24px);
    overflow: auto;
  }
  .drawer[hidden] {
    display: none;
  }
  .drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .drawer__item {
    display: block;
    padding: 9px 16px;
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--on-surface);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  a.drawer__item:hover {
    color: var(--secondary);
    background: var(--surface-container-high);
  }
  .drawer__item--active {
    color: var(--surface);
    background: var(--secondary);
    font-weight: 700;
  }
  .drawer__item--active:hover {
    color: var(--surface);
    background: var(--secondary-hover);
  }
  .drawer__item:focus-visible {
    outline-offset: -3px;
    outline-color: #fff;
  }

  /* Ticket button ----------------------------------------------------------- */
  .ticket-btn {
    width: var(--hdr-ticket-size);
    height: var(--hdr-ticket-size);
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    text-align: center;
  }
  .ticket-btn:hover {
    background: #000;
  }
  /* CMS image instead of the text: the image fills the round button. */
  .ticket-btn--image {
    overflow: hidden;
    padding: 0;
  }
  .ticket-btn__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ticket-btn__top {
    display: flex;
    gap: 2px;
    line-height: 1;
  }
  .ticket-btn__get,
  .ticket-btn__your,
  .ticket-btn__main {
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1;
  }
  /* Text scales with the button (9px / 13px at the former 56px size). */
  .ticket-btn__get {
    font-size: calc(var(--hdr-ticket-size) * 0.16);
    color: #e53935;
  }
  .ticket-btn__your {
    font-size: calc(var(--hdr-ticket-size) * 0.16);
    color: #fbc02d;
  }
  .ticket-btn__main {
    font-size: calc(var(--hdr-ticket-size) * 0.232);
    color: #43a047;
    letter-spacing: 0.06em;
  }
</style>

<script>
  import { recordFrame } from '../lib/record-burger';

  // Animate the hamburger ↔ record loop. Skipped for reduced motion (the
  // server-rendered first frame is the plain hamburger).
  function initRecord() {
    const svg = document.querySelector<SVGSVGElement>('[data-record]');
    if (!svg || svg.dataset.animate === 'false' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const part = <T extends Element>(name: string) => svg.querySelector<T>(`[data-r="${name}"]`)!;
    const shadow = part<SVGEllipseElement>('shadow');
    const disc = part<SVGCircleElement>('disc');
    const rim = part<SVGCircleElement>('rim');
    const clip = part<SVGCircleElement>('clip');
    const spin = part<SVGGElement>('spin');
    const grooves = part<SVGGElement>('grooves');
    const grooveCircles = [...svg.querySelectorAll<SVGCircleElement>('[data-groove]')];
    const bars = [...svg.querySelectorAll<SVGRectElement>('[data-r="bar"]')];
    const label = part<SVGGElement>('label');
    const reflection = part<SVGGElement>('reflection');
    const wedges = [...reflection.querySelectorAll('path')];
    const arm = part<SVGGElement>('arm');
    const set = (el: Element, attrs: Record<string, number | string>) => {
      for (const [name, value] of Object.entries(attrs)) el.setAttribute(name, typeof value === 'number' ? value.toFixed(2) : value);
    };

    const start = performance.now();
    const tick = (now: number) => {
      const f = recordFrame((now - start) / 1000);
      set(shadow, { cy: f.R * 0.12 + 14, rx: f.R * 0.98, ry: f.R * 0.96 });
      set(disc, { r: f.R });
      set(rim, { r: f.R - 0.5 });
      set(clip, { r: f.clipR });
      set(spin, { transform: `rotate(${f.angle.toFixed(2)})` });
      set(grooves, { opacity: f.m });
      if (f.m > 0) grooveCircles.forEach((circle) => set(circle, { r: Number(circle.dataset.groove) * (f.R / 215) }));
      f.bars.forEach((bar, i) => set(bars[i], bar));
      set(label, { opacity: f.labelOpacity });
      set(reflection, { opacity: f.m * 0.9 });
      wedges.forEach((wedge, i) => set(wedge, { d: f.reflection[i] }));
      set(arm, { opacity: f.armOpacity, transform: `translate(232 -222) rotate(${f.arm.toFixed(2)})` });
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
  initRecord();

  function initMenu() {
    const root = document.querySelector<HTMLElement>('[data-menu]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const drawer = document.querySelector<HTMLElement>('[data-menu-drawer]');
    const overlay = document.querySelector<HTMLElement>('[data-menu-overlay]');
    if (!root || !toggle || !drawer || !overlay) return;

    const setOpen = (open: boolean, restoreFocus = false) => {
      drawer.hidden = !open;
      overlay.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      if (open) drawer.querySelector<HTMLAnchorElement>('a')?.focus();
      if (!open && restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(drawer.hidden);
    });
    overlay.addEventListener('click', () => setOpen(false, true));
    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (!drawer.hidden && target && !root.contains(target) && !target.closest('[data-menu-overlay]')) {
        setOpen(false, true);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) setOpen(false, true);
    });
    // Close when a drawer link is clicked (navigation happens anyway).
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }

  initMenu();
</script>
