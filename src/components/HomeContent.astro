---
// Homepage content, shared by / and the /feedback page (shown dimmed behind
// the testing dialog).
import Hero from './Hero.astro';
import Countdown from './Countdown.astro';
import { site } from '../data/site';
import { heroImages } from '../data/pages';

const aftermovieId = (() => {
  try {
    return new URL(site.aftermovie.embedUrl).pathname.split('/').filter(Boolean).pop() ?? '';
  } catch {
    return '';
  }
})();
---

<div class="home">
  <Hero src={heroImages.home} alt="Festival grounds at night" size="lg" />
  <div class="home__body">
    <h1 class="home__title">{site.name}</h1>
    <p class="home__dates">{site.datesLabel}</p>

    {site.showCountdown && <Countdown date={site.festivalDate} />}

    <p class="home__intro">{site.intro}</p>

    {
      site.showAftermovie && (
        <div class="aftermovie">
          <h3 class="aftermovie__title">{site.aftermovie.title}</h3>
          <div class="aftermovie__frame">
            <iframe src={`https://www.youtube-nocookie.com/embed/${encodeURIComponent(aftermovieId)}`} title={site.aftermovie.title} loading="lazy" allowfullscreen></iframe>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .home {
    width: 100%;
  }
  .home__body {
    width: 100%;
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: 44px 24px 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .home__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 44px);
    letter-spacing: 0.06em;
    color: var(--secondary);
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 10px;
  }
  .home__dates {
    font-family: var(--font-display);
    font-size: clamp(13px, 1.6vw, 17px);
    letter-spacing: 0.14em;
    color: var(--on-surface);
    text-transform: uppercase;
    margin: 0 0 28px;
  }
  .home__intro {
    color: var(--on-surface);
    font-size: clamp(15px, 1.7vw, 17px);
    line-height: 1.75;
    text-align: center;
    max-width: 760px;
    margin: 0 0 40px;
    text-wrap: pretty;
  }

  .aftermovie {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .aftermovie__title {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 24px);
    letter-spacing: 0.08em;
    color: var(--secondary);
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 22px;
  }
  .aftermovie__frame {
    width: 100%;
    max-width: 820px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--border-hairline);
  }
  .aftermovie__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .aftermovie__frame p {
    color: var(--muted);
    font-size: 13px;
    margin: 0;
  }
  .aftermovie__frame a {
    font-size: 13px;
    text-decoration: underline;
  }
</style>
