---
import type { CopyBlock } from '../data/types';
import { inlineHtml, paragraphsHtml } from '../lib/richtext';

interface Props {
  blocks: CopyBlock[];
}
const { blocks } = Astro.props;
---

{
  blocks.map((b) =>
    b.type === 'h' ? <h2 class="copy__h" set:html={inlineHtml(b.html)} /> : paragraphsHtml(b.html).map((html) => <p set:html={html} />),
  )
}

<style>
  .copy__h {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 24px);
    letter-spacing: 0.08em;
    color: var(--secondary);
    text-transform: uppercase;
    margin: 28px 0 12px;
  }
</style>
