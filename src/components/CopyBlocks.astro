---
import type { CopyBlock } from '../data/types';
import { inlineHtml, paragraphsHtml } from '../lib/richtext';

interface Props {
  blocks: CopyBlock[];
}
const { blocks } = Astro.props;
---

{
  blocks.map((b) =>
    b.type === 'cols' ? (
      <dl class="copy__cols">
        {(b.rows ?? [])
          .filter((r) => r.left?.trim() || r.right?.trim())
          .map((r) => (
            <>
              <dt set:html={inlineHtml(r.left)} />
              <dd set:html={inlineHtml(r.right)} />
            </>
          ))}
      </dl>
    ) : b.type === 'h' ? (
      <h2 class="copy__h" set:html={inlineHtml(b.html)} />
    ) : (
      paragraphsHtml(b.html).map((html) => <p set:html={html} />)
    ),
  )
}

<style>
  .copy__h {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 24px);
    letter-spacing: 0.08em;
    color: var(--secondary);
    text-transform: uppercase;
    margin: 28px 0 12px;
  }
  /* Two-column list: one grid so every row shares the column widths. */
  .copy__cols {
    display: grid;
    grid-template-columns: fit-content(55%) 1fr;
    max-width: 36rem;
    margin: 0 auto 22px;
  }
  .copy__cols:last-child {
    margin-bottom: 0;
  }
  .copy__cols dt,
  .copy__cols dd {
    margin: 0;
    padding: 8px 0;
  }
  .copy__cols dt {
    text-align: left;
  }
  .copy__cols dd {
    padding-left: 24px;
    text-align: right;
  }
</style>
